---
import BaseLayout from '../layouts/BaseLayout.astro';

const productos = [
  {
    nombre: 'Maneki-neko Tradicional de Porcelana Blanca (15 cm)',
    categoria: 'Cerámica Japonesa',
    descripcion: 'Diseño clásico Mi-ke con pata derecha alzada para atraer prosperidad y armonía en el hogar.',
    precio: '24,90 €',
    url: 'https://www.amazon.es/s?k=maneki+neko+ceramica+japonesa',
  },
  {
    nombre: 'Maneki-neko Dorado Solar con Movimiento Continuo',
    categoria: 'Comercios y Negocios',
    descripcion: 'Funciona sin pilas mediante panel solar integrado. Ideal para mostradores y recepciones.',
    precio: '16,50 €',
    url: 'https://www.amazon.es/s?k=maneki+neko+dorado+solar',
  },
  {
    nombre: 'Maneki-neko Negro Guardián en Cerámica Mate',
    categoria: 'Protección',
    descripcion: 'Amuleto tradicional orientado a disipar energías negativas y proteger espacios de trabajo.',
    precio: '21,00 €',
    url: 'https://www.amazon.es/s?k=maneki+neko+negro+ceramica',
  },
];
---

<BaseLayout
  title="Selección de Maneki-neko Tradicionales | Manekineko.es"
  description="Curaduría de figuras Maneki-neko de cerámica, huchas y modelos solares recomendados."
>
  <section class="max-w-5xl mx-auto px-6 py-16">
    <p class="text-xs uppercase tracking-[0.25em] text-[#B91C1C] mb-3">Curaduría</p>
    <h1 class="font-serif text-3xl sm:text-4xl mb-4">Selección Tradicional</h1>
    <p class="text-stone-600 max-w-2xl mb-12">
      Una selección filtrada de figuras tradicionales de cerámica y modelos solares disponibles online.
    </p>

    <div class="grid md:grid-cols-3 gap-8">
      {productos.map((item) => (
        <div class="border border-stone-200 bg-white p-6 flex flex-col justify-between">
          <div>
            <span class="text-[11px] uppercase tracking-widest text-[#B91C1C]">{item.categoria}</span>
            <h2 class="font-serif text-xl mt-2 mb-3">{item.nombre}</h2>
            <p class="text-sm text-stone-600 leading-relaxed mb-6">{item.descripcion}</p>
          </div>
          <div class="pt-4 border-t border-stone-100 flex items-center justify-between">
            <span class="font-medium text-base">{item.precio}</span>
            <a
              href={item.url}
              target="_blank"
              rel="sponsored nofollow noopener"
              class="px-4 py-2 bg-[#1A1A1A] text-white text-xs uppercase tracking-wider hover:bg-[#B91C1C] transition-colors"
            >
              Ver disponibilidad
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>