---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { homeTranslations } from '../../i18n/home';

const tr = homeTranslations.es;
const leyendas = (await getCollection('leyendas')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout title="Leyendas del Maneki-neko | Manekineko.es" description={tr.seoDescription}>
  <section class="max-w-6xl mx-auto px-6 py-12 sm:py-16">
    <header class="max-w-3xl mx-auto text-center mb-14">
      <div class="inline-flex items-center gap-2.5 mb-3">
        <span class="hanko-stamp px-2.5 py-0.5 text-[10px] font-bold tracking-widest uppercase bg-white">
          {tr.legendsBadge}
        </span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl text-[#161412] font-bold leading-tight mb-4">
        {tr.legendsTitle}
      </h1>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {leyendas.map((leyenda) => (
        <article class="group bg-white border border-[#E5DEC9] rounded-2xl overflow-hidden shadow-xs hover:shadow-md transition-all duration-300 flex flex-col">
          <a href={`/leyendas/${leyenda.id}/`} class="block overflow-hidden aspect-[3/2] bg-[#FAF6F0] relative">
            <img
              src={leyenda.data.coverImage}
              alt={leyenda.data.coverAlt}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <span class="absolute top-3 left-3 px-3 py-1 text-xs font-semibold rounded-full bg-white/95 text-[#8E1323] border border-[#E5DEC9]">
              {leyenda.data.isOriginal ? tr.legendsOriginalBadge : leyenda.data.era}
            </span>
          </a>

          <div class="p-6 flex-1 flex flex-col">
            <div class="text-xs text-stone-500 mb-2 flex items-center justify-between">
              <span>{leyenda.data.location}</span>
              <span>{leyenda.data.readingTime}</span>
            </div>

            <h2 class="font-serif text-xl font-bold text-[#161412] group-hover:text-[#8E1323] transition-colors mb-3">
              <a href={`/leyendas/${leyenda.id}/`}>{leyenda.data.title}</a>
            </h2>

            <p class="text-sm text-stone-600 leading-relaxed mb-6 flex-1">{leyenda.data.summary}</p>

            <div class="pt-4 border-t border-[#E5DEC9]">
              <a href={`/leyendas/${leyenda.id}/`} class="text-sm font-semibold text-[#8E1323] hover:text-[#700E1B] inline-flex items-center gap-1">
                {tr.legendsReadMore}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>