---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('cultura')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Manekineko.es — Historia, Significado y Cultura del Gato de la Suerte"
  description="Descubre el origen japonés del Maneki-neko, el significado de sus colores, cómo colocarlo según el Feng Shui y una selección curada de piezas tradicionales."
>
  <section class="max-w-4xl mx-auto px-6 pt-20 pb-16 text-center">
    <p class="text-xs uppercase tracking-[0.3em] text-[#B91C1C] mb-4">招き猫 • Tradición Japonesa</p>
    <h1 class="font-serif text-4xl sm:text-5xl font-normal leading-tight text-[#1A1A1A] mb-6">
      El arte de invitar a la buena fortuna
    </h1>
    <p class="text-stone-600 text-lg max-w-2xl mx-auto leading-relaxed mb-10">
      Un espacio dedicado a la historia auténtica del Maneki-neko: desde las leyendas del periodo Edo en Tokio hasta el simbolismo de cada color y gesto.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/cultura/" class="px-6 py-3 bg-[#1A1A1A] text-white text-sm tracking-wide hover:bg-[#B91C1C] transition-colors">
        Explorar la revista
      </a>
      <a href="/tienda/" class="px-6 py-3 border border-stone-300 text-sm tracking-wide hover:border-[#1A1A1A] transition-colors">
        Ver selección tradicional
      </a>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-12 border-t border-stone-200/80">
    <div class="flex items-baseline justify-between mb-10">
      <h2 class="font-serif text-2xl">Últimos artículos culturales</h2>
      <a href="/cultura/" class="text-sm text-[#B91C1C] hover:underline">Ver todos →</a>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {posts.map((post) => (
        <article class="group border border-stone-200 bg-white/60 p-6 flex flex-col justify-between hover:border-stone-400 transition-colors">
          <div>
            <div class="flex items-center gap-2 text-xs text-stone-500 mb-3">
              <span class="text-[#B91C1C] font-medium uppercase tracking-wider">{post.data.category}</span>
              <span>•</span>
              <span>{post.data.readTime}</span>
            </div>
            <h3 class="font-serif text-xl mb-3 group-hover:text-[#B91C1C] transition-colors">
              <a href={`/cultura/${post.id}/`}>{post.data.title}</a>
            </h3>
            <p class="text-sm text-stone-600 leading-relaxed mb-6">
              {post.data.description}
            </p>
          </div>
          <a href={`/cultura/${post.id}/`} class="text-xs font-medium uppercase tracking-widest text-[#1A1A1A] group-hover:text-[#B91C1C]">
            Leer artículo →
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>