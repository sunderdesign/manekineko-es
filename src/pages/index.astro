---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Manekineko.es — Cultura, Simbolismo y Tradición del Gato de la Fortuna"
  description="Configura y descubre el significado tradicional del Maneki-neko japonés: combina pata levantada, color del pelaje y recorre su historia cronológica."
>
  <!-- 1. GRAN EXPLORADOR INTERACTIVO MINIMALISTA -->
  <section class="bg-seigaiha border-b border-[#E5DEC9] relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-6 py-5 sm:py-7 w-full">
      
      <!-- Fila Superior: Frase Dinámica (Izquierda) + Gato con Esquema Minimalista (Derecha) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
        
        <!-- Columna Izquierda (5 cols): Frase Dinámica + Significado -->
        <div class="lg:col-span-5 text-center lg:text-left flex flex-col justify-center">
          <div class="inline-flex flex-wrap items-center gap-2.5 mb-3 justify-center lg:justify-start">
            <span class="hanko-stamp px-2 py-0.5 text-[10px] font-bold tracking-widest uppercase bg-white/85">
              招き猫 • CONFIGURACIÓN
            </span>
            <span id="meta-tags" class="text-[11px] uppercase tracking-[0.16em] text-[#8E1323] font-semibold">
              Pata Izquierda • Color Blanco
            </span>
          </div>

          <h1 id="dynamic-headline" class="font-serif text-2xl sm:text-3xl lg:text-[1.9rem] leading-[1.2] text-[#161412] mb-3 transition-opacity duration-200">
            El Maneki-neko <span class="text-stone-600 italic">blanco</span> que alza <span class="underline decoration-[#8E1323]/40 decoration-2 underline-offset-4">la pata izquierda</span> para atraer clientes y armonía
          </h1>

          <p id="dynamic-meaning" class="text-sm text-stone-700 leading-relaxed max-w-xl mx-auto lg:mx-0 transition-opacity duration-200">
            Su gesto con la pata izquierda da la bienvenida a visitantes, clientes y vínculos positivos. Al ser blanco como los gatos del templo Gōtokuji, aporta pureza, calma y buena fortuna general al hogar.
          </p>
        </div>

        <!-- Columna Derecha (7 cols): Medallón Blanco Grande + Línea Fina SVG + Texto Minimalista -->
        <div class="lg:col-span-7 flex flex-col items-center">
          <div id="schematic-stage" class="relative w-full flex flex-col sm:flex-row items-center justify-center lg:justify-end gap-5 sm:gap-8">
            
            <!-- Capa SVG para la línea conectora -->
            <svg id="schematic-svg" class="hidden sm:block absolute inset-0 w-full h-full pointer-events-none z-30" aria-hidden="true">
              <path id="schematic-line-halo" d="" fill="none" stroke="#FAF6F0" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" opacity="0" />
              <path id="schematic-line" d="" fill="none" stroke="#8E1323" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" opacity="0" />
              <circle id="schematic-end-dot" cx="0" cy="0" r="2.5" fill="#8E1323" opacity="0" />
            </svg>

            <!-- Medallón del Gato (Fondo Blanco Fijo y Mayor Tamaño) -->
            <div class="relative w-64 h-64 sm:w-72 sm:h-72 shrink-0 flex items-center justify-center rounded-full overflow-hidden bg-white border-2 border-[#C6922C]/45 shadow-xl">
              <div class="absolute inset-3 rounded-full border border-dashed border-[#161412]/15 pointer-events-none z-20"></div>
              
              <img
                id="interactive-cat"
                src="/MN_1_02_white.svg"
                alt="Maneki-neko blanco con la pata izquierda levantada"
                class="w-44 sm:w-48 h-auto object-contain relative z-10 transition-transform duration-500 ease-in-out"
              />

              <!-- Hotspots calibrados a las proporciones de MN_1 y MN_2 -->
              <button
                id="hotspot-koban"
                data-info="koban"
                class="hotspot absolute z-20 left-[45%] top-[73%] -translate-x-1/2 -translate-y-1/2 w-4 h-4 sm:w-4.5 sm:h-4.5 rounded-full bg-[#E2B455]/85 border border-white shadow-sm animate-pulse hover:animate-none hover:scale-125 transition-all duration-300 cursor-pointer"
                aria-label="Moneda Koban"
                title="Moneda Koban"
              ></button>

              <button
                data-info="collar"
                class="hotspot absolute z-20 left-[50%] top-[53%] -translate-x-1/2 -translate-y-1/2 w-4 h-4 sm:w-4.5 sm:h-4.5 rounded-full bg-[#8E1323]/80 border border-white shadow-sm animate-pulse hover:animate-none hover:scale-125 transition-all duration-300 cursor-pointer"
                aria-label="Collar y Cascabel"
                title="Collar y Cascabel"
              ></button>

              <button
                data-info="cara"
                class="hotspot absolute z-20 left-[50%] top-[34%] -translate-x-1/2 -translate-y-1/2 w-4 h-4 sm:w-4.5 sm:h-4.5 rounded-full bg-stone-700/65 border border-white shadow-sm animate-pulse hover:animate-none hover:scale-125 transition-all duration-300 cursor-pointer"
                aria-label="Expresión de la cara"
                title="Expresión y mirada"
              ></button>
            </div>

            <!-- Descripción Minimalista sin recuadro -->
            <div id="anatomy-panel" class="w-full sm:w-52 shrink-0 border-l border-stone-300/80 pl-3.5 py-1 text-center sm:text-left relative z-20 opacity-45 transition-all duration-300">
              <div id="anatomy-tag" class="text-[10px] font-semibold uppercase tracking-[0.18em] text-stone-500 mb-1">
                Rasgos • 細部
              </div>

              <h2 id="anatomy-name" class="font-serif text-sm sm:text-base font-medium text-stone-600 mb-1">
                Explora la figura
              </h2>

              <p id="anatomy-text" class="text-xs text-stone-500 leading-relaxed">
                Señala o pulsa los puntos del gato para ver cada detalle.
              </p>
            </div>

          </div>
        </div>
      </div>

      <!-- Barra Inferior de Controles + Botón Buscar -->
      <div class="mt-5 w-full bg-white/90 backdrop-blur-sm border border-[#E5DEC9] rounded-2xl p-2.5 shadow-sm flex flex-col lg:flex-row items-center justify-between gap-3">
        
        <div class="flex flex-col md:flex-row items-center justify-center lg:justify-start gap-4 flex-1">
          <!-- Bloque Izquierdo: Pata -->
          <div class="flex flex-wrap items-center justify-center gap-2 pl-2">
            <span class="text-[11px] font-bold uppercase tracking-widest text-stone-400 mr-1">Pata:</span>
            <button data-type="paw" data-key="left" class="control-btn active px-3 py-1.5 rounded-lg bg-[#161412] text-white text-xs font-medium transition-colors cursor-pointer">Izquierda</button>
            <button data-type="paw" data-key="right" class="control-btn px-3 py-1.5 rounded-lg bg-[#FAF6F0] text-stone-600 border border-stone-200 text-xs font-medium hover:bg-stone-200 transition-colors cursor-pointer">Derecha</button>
            <button data-type="paw" data-key="both" class="control-btn px-3 py-1.5 rounded-lg bg-[#FAF6F0] text-stone-600 border border-stone-200 text-xs font-medium hover:bg-stone-200 transition-colors cursor-pointer">Ambas</button>
          </div>

          <!-- Separador vertical -->
          <div class="hidden md:block h-6 w-px bg-stone-200"></div>

          <!-- Bloque Medio: Colores -->
          <div class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-3">
            <span class="text-[11px] font-bold uppercase tracking-widest text-stone-400 mr-1">Color:</span>
            
            <button data-type="color" data-key="tricolor" data-ring="ring-amber-700" class="control-color w-6 h-6 rounded-full bg-gradient-to-tr from-stone-900 via-amber-500 to-white border border-stone-400 shadow-sm transition-transform hover:scale-110 ring-2 ring-offset-2 ring-transparent cursor-pointer" aria-label="Tricolor Mi-ke" title="Tricolor (Mi-ke)"></button>
            <button data-type="color" data-key="white" data-ring="ring-stone-800" class="control-color w-6 h-6 rounded-full bg-white border-2 border-stone-500 shadow-sm transition-transform hover:scale-110 ring-2 ring-offset-2 ring-stone-800 scale-110 cursor-pointer" aria-label="Blanco" title="Blanco"></button>
            <button data-type="color" data-key="gold" data-ring="ring-amber-600" class="control-color w-6 h-6 rounded-full bg-gradient-to-tr from-[#B7811E] to-[#FFF1B8] border border-amber-500 shadow-sm transition-transform hover:scale-110 ring-2 ring-offset-2 ring-transparent cursor-pointer" aria-label="Dorado" title="Dorado"></button>
            <button data-type="color" data-key="yellow" data-ring="ring-yellow-500" class="control-color w-6 h-6 rounded-full bg-yellow-300 border border-yellow-500 shadow-sm transition-transform hover:scale-110 ring-2 ring-offset-2 ring-transparent cursor-pointer" aria-label="Amarillo" title="Amarillo"></button>
            <button data-type="color" data-key="green" data-ring="ring-emerald-600" class="control-color w-6 h-6 rounded-full bg-emerald-600 border border-emerald-800 shadow-sm transition-transform hover:scale-110 ring-2 ring-offset-2 ring-transparent cursor-pointer" aria-label="Verde" title="Verde"></button>
            <button data-type="color" data-key="blue" data-ring="ring-sky-600" class="control-color w-6 h-6 rounded-full bg-sky-600 border border-sky-800 shadow-sm transition-transform hover:scale-110 ring-2 ring-offset-2 ring-transparent cursor-pointer" aria-label="Azul" title="Azul"></button>
            <button data-type="color" data-key="purple" data-ring="ring-purple-700" class="control-color w-6 h-6 rounded-full bg-purple-700 border border-purple-900 shadow-sm transition-transform hover:scale-110 ring-2 ring-offset-2 ring-transparent cursor-pointer" aria-label="Morado" title="Morado / Púrpura"></button>
            <button data-type="color" data-key="pink" data-ring="ring-rose-400" class="control-color w-6 h-6 rounded-full bg-rose-300 border border-rose-400 shadow-sm transition-transform hover:scale-110 ring-2 ring-offset-2 ring-transparent cursor-pointer" aria-label="Rosa" title="Rosa"></button>
            <button data-type="color" data-key="red" data-ring="ring-[#8E1323]" class="control-color w-6 h-6 rounded-full bg-[#8E1323] border border-red-950 shadow-sm transition-transform hover:scale-110 ring-2 ring-offset-2 ring-transparent cursor-pointer" aria-label="Rojo" title="Rojo"></button>
            <button data-type="color" data-key="black" data-ring="ring-stone-800" class="control-color w-6 h-6 rounded-full bg-[#18181B] border border-black shadow-sm transition-transform hover:scale-110 ring-2 ring-offset-2 ring-transparent cursor-pointer" aria-label="Negro" title="Negro"></button>
          </div>
        </div>

        <!-- Botón de Acción Principal -->
        <a 
          href="/tienda/?color=white&pata=left" 
          id="btn-search-figure"
          class="shrink-0 w-full lg:w-auto flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#8E1323] to-[#700E1B] text-white font-medium text-sm tracking-wide shadow-md hover:shadow-lg transition-all group"
        >
          <span>Encontrar figura</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>

      </div>
    </div>
  </section>

  <!-- 2. LÍNEA DE TIEMPO HORIZONTAL INTERACTIVA (TRADICIÓN Y LEYENDA) -->
  <section id="tradicion" class="max-w-6xl mx-auto px-6 py-16 sm:py-20">
    
    <!-- Encabezado de Sección -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2.5 mb-2.5">
        <span class="hanko-stamp px-2 py-0.5 text-[10px] font-bold tracking-widest uppercase bg-white/90">
          歴史 • TRADICIÓN Y LEYENDA
        </span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl text-[#161412] mb-3">
        De los talismanes rústicos al gato imperial
      </h2>
      <p class="text-stone-600 text-sm sm:text-base">
        Pulsa sobre cada etapa cronológica para desplegar su historia, sus leyendas y la evolución de su estética en Japón.
      </p>
    </div>

    <!-- EJE HORIZONTAL DE FECHAS -->
    <div class="relative mb-10 overflow-x-auto pb-4">
      <div class="min-w-[640px] relative px-6 pt-2">
        
        <!-- Línea base horizontal -->
        <div class="absolute top-[42px] left-12 right-12 h-[2px] bg-[#E5DEC9]"></div>
        <!-- Línea de progreso activa -->
        <div id="timeline-progress" class="absolute top-[42px] left-12 h-[2px] bg-[#8E1323] transition-all duration-500" style="width: 0%;"></div>

        <!-- 5 Nodos Cronológicos -->
        <div class="relative z-10 grid grid-cols-5 gap-2">
          
          <!-- Nodo 0: Pre-Edo -->
          <button type="button" data-era="0" class="era-node active flex flex-col items-center text-center group cursor-pointer focus:outline-none">
            <span class="era-year text-xs font-bold tracking-wider uppercase text-[#8E1323] mb-2 transition-colors">
              Siglo XVI
            </span>
            <span class="era-dot w-5 h-5 rounded-full bg-[#8E1323] border-4 border-[#FAF6F0] ring-2 ring-[#8E1323] scale-125 transition-all duration-300 shadow-xs"></span>
            <span class="era-label font-serif text-sm font-semibold text-[#161412] mt-3 leading-tight">
              Antes del Gato
            </span>
            <span class="text-[11px] text-stone-500 mt-0.5">Talismanes Pre-Edo</span>
          </button>

          <!-- Nodo 1: 1615 Gōtokuji -->
          <button type="button" data-era="1" class="era-node flex flex-col items-center text-center group cursor-pointer focus:outline-none">
            <span class="era-year text-xs font-bold tracking-wider uppercase text-stone-500 group-hover:text-[#8E1323] mb-2 transition-colors">
              Año 1615
            </span>
            <span class="era-dot w-5 h-5 rounded-full bg-white border-[3px] border-[#C6922C] group-hover:border-[#8E1323] transition-all duration-300 shadow-xs"></span>
            <span class="era-label font-serif text-sm font-medium text-stone-600 group-hover:text-[#161412] mt-3 leading-tight">
              Templo Gōtokuji
            </span>
            <span class="text-[11px] text-stone-400 mt-0.5">La leyenda de Tama</span>
          </button>

          <!-- Nodo 2: Siglo XVIII Imado -->
          <button type="button" data-era="2" class="era-node flex flex-col items-center text-center group cursor-pointer focus:outline-none">
            <span class="era-year text-xs font-bold tracking-wider uppercase text-stone-500 group-hover:text-[#8E1323] mb-2 transition-colors">
              Siglo XVIII
            </span>
            <span class="era-dot w-5 h-5 rounded-full bg-white border-[3px] border-[#C6922C] group-hover:border-[#8E1323] transition-all duration-300 shadow-xs"></span>
            <span class="era-label font-serif text-sm font-medium text-stone-600 group-hover:text-[#161412] mt-3 leading-tight">
              Cerámica Imado
            </span>
            <span class="text-[11px] text-stone-400 mt-0.5">Usugumo y el Edo popular</span>
          </button>

          <!-- Nodo 3: Era Meiji -->
          <button type="button" data-era="3" class="era-node flex flex-col items-center text-center group cursor-pointer focus:outline-none">
            <span class="era-year text-xs font-bold tracking-wider uppercase text-stone-500 group-hover:text-[#8E1323] mb-2 transition-colors">
              1868 – 1912
            </span>
            <span class="era-dot w-5 h-5 rounded-full bg-white border-[3px] border-[#C6922C] group-hover:border-[#8E1323] transition-all duration-300 shadow-xs"></span>
            <span class="era-label font-serif text-sm font-medium text-stone-600 group-hover:text-[#161412] mt-3 leading-tight">
              Era Meiji
            </span>
            <span class="text-[11px] text-stone-400 mt-0.5">El relevo comercial</span>
          </button>

          <!-- Nodo 4: Siglo XX - Hoy -->
          <button type="button" data-era="4" class="era-node flex flex-col items-center text-center group cursor-pointer focus:outline-none">
            <span class="era-year text-xs font-bold tracking-wider uppercase text-stone-500 group-hover:text-[#8E1323] mb-2 transition-colors">
              Siglo XX – Hoy
            </span>
            <span class="era-dot w-5 h-5 rounded-full bg-white border-[3px] border-[#C6922C] group-hover:border-[#8E1323] transition-all duration-300 shadow-xs"></span>
            <span class="era-label font-serif text-sm font-medium text-stone-600 group-hover:text-[#161412] mt-3 leading-tight">
              Tokoname y Mundo
            </span>
            <span class="text-[11px] text-stone-400 mt-0.5">Icono universal</span>
          </button>

        </div>
      </div>
    </div>

    <!-- CONTENEDOR DE FICHAS DESPLEGABLES POR ÉPOCA -->
    <div class="bg-white border border-[#E5DEC9] rounded-2xl shadow-sm overflow-hidden">
      
      <!-- FICHA 0: PRE-EDO (SIGLO XVI) -->
      <article id="era-panel-0" class="era-panel p-6 sm:p-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-4">
          <div class="flex flex-wrap items-center gap-3">
            <span class="hanko-stamp px-2.5 py-0.5 text-xs font-bold">先史 • ETAPA I</span>
            <span class="text-xs font-semibold uppercase tracking-widest text-[#C6922C]">Siglo XVI • Periodo Sengoku / Pre-Edo</span>
          </div>
          
          <h3 class="font-serif text-2xl sm:text-3xl text-[#161412]">
            Antes del gato: Dōsojin y talismanes de fertilidad
          </h3>
          
          <p class="text-sm sm:text-base text-stone-700 leading-relaxed">
            Mucho antes de que el gato levantara su pata en los escaparates de Tokio, los comerciantes, agricultores y viajeros japoneses confiaban su prosperidad a amuletos sintoístas de carácter rústico. En los cruces de caminos se erigían los <strong>Dōsojin</strong>, deidades protectoras talladas en piedra que resguardaban las aldeas de epidemias y malos espíritus.
          </p>
          
          <p class="text-sm sm:text-base text-stone-700 leading-relaxed">
            Junto a ellos, en posadas, casas de té y comercios populares era habitual exhibir <strong>amuletos fálicos de madera o cerámica</strong> (<em>Konsei-sama</em>). En la mentalidad tradicional nipona no tenían connotación obscena, sino que representaban la fertilidad de la tierra, la continuidad familiar y la multiplicación de las ventas.
          </p>

          <div class="bg-[#FAF6F0] border-l-2 border-[#C6922C] p-4 rounded-r-lg">
            <p class="text-xs text-stone-600 leading-relaxed">
              <strong class="text-[#161412]">Parafernalia ritual:</strong> Estos talismanes solían acompañarse de cuerdas sagradas <em>shimenawa</em> y ofrendas de sake o arroz para pedir prosperidad en los negocios nacientes.
            </p>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="aspect-[4/3] rounded-xl bg-[#FAF6F0] border border-dashed border-[#C6922C]/60 flex flex-col items-center justify-center p-6 text-center relative overflow-hidden">
            <span class="font-serif text-4xl text-[#C6922C]/40 mb-2">道祖神</span>
            <p class="font-serif text-sm text-stone-700">Espacio para ilustración o fotografía</p>
            <p class="text-xs text-stone-400 mt-1">Piedras Dōsojin / Talismanes tradicionales Pre-Edo</p>
          </div>
        </div>
      </article>

      <!-- FICHA 1: 1615 TEMPLO GŌTOKUJI -->
      <article id="era-panel-1" class="era-panel hidden p-6 sm:p-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-4">
          <div class="flex flex-wrap items-center gap-3">
            <span class="hanko-stamp px-2.5 py-0.5 text-xs font-bold">江戸 • ETAPA II</span>
            <span class="text-xs font-semibold uppercase tracking-widest text-[#C6922C]">Año 1615 • Inicio del Periodo Edo</span>
          </div>
          
          <h3 class="font-serif text-2xl sm:text-3xl text-[#161412]">
            La leyenda de Tama y el templo Gōtokuji
          </h3>
          
          <p class="text-sm sm:text-base text-stone-700 leading-relaxed">
            La crónica más célebre sitúa el nacimiento del Maneki-neko en el distrito de Setagaya (Tokio). El señor feudal <strong>Ii Naotaka</strong> regresaba de una cacería cuando estalló una tormenta eléctrica. Refugiado bajo un árbol, vio a <strong>Tama</strong>, el gato blanco del humilde monje del templo Gōtokuji, alzando una pata como si le invitara a entrar.
          </p>
          
          <p class="text-sm sm:text-base text-stone-700 leading-relaxed">
            Apenas el samurái dio unos pasos hacia el templo, un rayo fulminó el árbol donde había estado segundos antes. Agradecido por salvarle la vida, Naotaka financió la reconstrucción completa del templo y lo convirtió en el santuario familiar de su clan.
          </p>

          <div class="bg-[#FAF6F0] border-l-2 border-[#8E1323] p-4 rounded-r-lg">
            <p class="text-xs text-stone-600 leading-relaxed">
              <strong class="text-[#161412]">Dato curioso:</strong> Los gatos votivos del templo Gōtokuji son siempre blancos, llevan la pata derecha alzada y <strong>no sostienen moneda koban</strong>, pues la tradición local sostiene que el gato da la oportunidad, pero el esfuerzo depende de cada persona.
            </p>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="aspect-[4/3] rounded-xl bg-[#FAF6F0] border border-dashed border-[#C6922C]/60 flex flex-col items-center justify-center p-6 text-center relative overflow-hidden">
            <span class="font-serif text-4xl text-[#8E1323]/35 mb-2">豪徳寺</span>
            <p class="font-serif text-sm text-stone-700">Espacio para fotografía del Templo Gōtokuji</p>
            <p class="text-xs text-stone-400 mt-1">Altar de miles de gatos blancos en Setagaya, Tokio</p>
          </div>
        </div>
      </article>

      <!-- FICHA 2: SIGLO XVIII CERÁMICA IMADO -->
      <article id="era-panel-2" class="era-panel hidden p-6 sm:p-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-4">
          <div class="flex flex-wrap items-center gap-3">
            <span class="hanko-stamp px-2.5 py-0.5 text-xs font-bold">今戸 • ETAPA III</span>
            <span class="text-xs font-semibold uppercase tracking-widest text-[#C6922C]">Siglo XVIII • Esplendor Cultural de Edo</span>
          </div>
          
          <h3 class="font-serif text-2xl sm:text-3xl text-[#161412]">
            Usugumo, el santuario Imado y las primeras figuras
          </h3>
          
          <p class="text-sm sm:text-base text-stone-700 leading-relaxed">
            En el barrio de Asakusa surgió otra leyenda clave: la cortesana <strong>Usugumo</strong> adoraba a su gato hasta el punto de que el dueño de su casa de té pensó que el animal la había hechizado y lo decapitó. La cabeza del felino voló y mordió a una serpiente venenosa que acechaba desde el techo, salvando la vida de su dueña.
          </p>
          
          <p class="text-sm sm:text-base text-stone-700 leading-relaxed">
            Para consolarla, un admirador le regaló una estatuilla de cerámica cocida en los hornos locales de <strong>Imado</strong>. Estas piezas, llamadas <em>Marushime-neko</em>, se vendieron como amuletos de buena suerte en los alrededores del santuario Imado Jinja y aparecen ya retratadas en grabados <em>ukiyo-e</em> de Hiroshige en 1852.
          </p>

          <div class="bg-[#FAF6F0] border-l-2 border-[#C6922C] p-4 rounded-r-lg">
            <p class="text-xs text-stone-600 leading-relaxed">
              <strong class="text-[#161412]">Rasgo distintivo:</strong> Las figuras antiguas de Imado solían mostrarse de perfil mirando hacia un lado, con el babero rojo y un cascabel pintado a mano.
            </p>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="aspect-[4/3] rounded-xl bg-[#FAF6F0] border border-dashed border-[#C6922C]/60 flex flex-col items-center justify-center p-6 text-center relative overflow-hidden">
            <span class="font-serif text-4xl text-[#C6922C]/40 mb-2">今戸焼</span>
            <p class="font-serif text-sm text-stone-700">Espacio para grabado Ukiyo-e o cerámica Imado</p>
            <p class="text-xs text-stone-400 mt-1">Primeras representaciones comerciales en Asakusa</p>
          </div>
        </div>
      </article>

      <!-- FICHA 3: 1868 - 1912 ERA MEIJI -->
      <article id="era-panel-3" class="era-panel hidden p-6 sm:p-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-4">
          <div class="flex flex-wrap items-center gap-3">
            <span class="hanko-stamp px-2.5 py-0.5 text-xs font-bold">明治 • ETAPA IV</span>
            <span class="text-xs font-semibold uppercase tracking-widest text-[#C6922C]">1868 – 1912 • Restauración Meiji</span>
          </div>
          
          <h3 class="font-serif text-2xl sm:text-3xl text-[#161412]">
            La prohibición de los amuletos fálicos y el boom del gato
          </h3>
          
          <p class="text-sm sm:text-base text-stone-700 leading-relaxed">
            Con la apertura de Japón al exterior en 1868, el gobierno de la era Meiji impulsó una rápida modernización de las costumbres urbanas. En 1872 se promulgaron ordenanzas que prohibían exhibir en los escaparates y entradas de los comercios los antiguos amuletos fálicos de fertilidad, por considerarlos impropios ante los visitantes occidentales.
          </p>
          
          <p class="text-sm sm:text-base text-stone-700 leading-relaxed">
            Los comerciantes, que no querían quedarse sin un talismán protector junto a la entrada, encontraron en el <strong>Maneki-neko</strong> el sustituto ideal: amable, decorativo y cargado de simbolismo de prosperidad. Fue entonces cuando se popularizó añadirle la moneda de oro <em>koban</em> en el pecho.
          </p>

          <div class="bg-[#FAF6F0] border-l-2 border-[#8E1323] p-4 rounded-r-lg">
            <p class="text-xs text-stone-600 leading-relaxed">
              <strong class="text-[#161412]">Punto de inflexión:</strong> En apenas dos décadas pasó de ser una artesanía local de Tokio a convertirse en el emblema oficial del comercio japonés.
            </p>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="aspect-[4/3] rounded-xl bg-[#FAF6F0] border border-dashed border-[#C6922C]/60 flex flex-col items-center justify-center p-6 text-center relative overflow-hidden">
            <span class="font-serif text-4xl text-[#8E1323]/35 mb-2">明治時代</span>
            <p class="font-serif text-sm text-stone-700">Espacio para fotografía histórica Era Meiji</p>
            <p class="text-xs text-stone-400 mt-1">Comercios tradicionales y adopción de la moneda Koban</p>
          </div>
        </div>
      </article>

      <!-- FICHA 4: SIGLO XX - ACTUALIDAD TOKONAME -->
      <article id="era-panel-4" class="era-panel hidden p-6 sm:p-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-4">
          <div class="flex flex-wrap items-center gap-3">
            <span class="hanko-stamp px-2.5 py-0.5 text-xs font-bold">常滑 • ETAPA V</span>
            <span class="text-xs font-semibold uppercase tracking-widest text-[#C6922C]">Siglo XX – Actualidad • Tokoname y Mundo</span>
          </div>
          
          <h3 class="font-serif text-2xl sm:text-3xl text-[#161412]">
            El estilo Tokoname y la expansión internacional
          </h3>
          
          <p class="text-sm sm:text-base text-stone-700 leading-relaxed">
            A mediados del siglo XX, los talleres alfareros de <strong>Tokoname</strong> (prefectura de Aichi) crearon el molde que hoy reconoce todo el planeta: proporciones redondeadas, cabeza grande, ojos expresivos en sonrisa y colores vibrantes (dorado, negro, rojo o rosa) adaptados a cada deseo.
          </p>
          
          <p class="text-sm sm:text-base text-stone-700 leading-relaxed">
            Desde los barrios comerciales de Japón se extendió a restaurantes y hogares de toda Asia y Occidente, evolucionando también hacia versiones solares con pata articulada y piezas de diseño contemporáneo sin perder su esencia original de bienvenida y buena fortuna.
          </p>

          <div class="bg-[#FAF6F0] border-l-2 border-[#C6922C] p-4 rounded-r-lg">
            <p class="text-xs text-stone-600 leading-relaxed">
              <strong class="text-[#161412]">Capital del Maneki-neko:</strong> Hoy Tokoname produce cerca del 80 % de los Maneki-neko de cerámica tradicionales de Japón y cuenta con un paseo dedicado a esculturas gigantes del gato.
            </p>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="aspect-[4/3] rounded-xl bg-[#FAF6F0] border border-dashed border-[#C6922C]/60 flex flex-col items-center justify-center p-6 text-center relative overflow-hidden">
            <span class="font-serif text-4xl text-[#C6922C]/40 mb-2">常滑焼</span>
            <p class="font-serif text-sm text-stone-700">Espacio para fotografía de cerámica Tokoname</p>
            <p class="text-xs text-stone-400 mt-1">Artesanía contemporánea y variedad cromática</p>
          </div>
        </div>
      </article>

      <!-- Barra inferior de navegación rápida entre etapas -->
      <div class="bg-[#FAF6F0] border-t border-[#E5DEC9] px-6 py-3 flex items-center justify-between text-xs">
        <button type="button" id="prev-era" class="font-medium text-stone-500 hover:text-[#8E1323] disabled:opacity-35 disabled:pointer-events-none transition-colors cursor-pointer" disabled>
          ← Etapa anterior
        </button>
        <span id="era-step-indicator" class="text-stone-500 font-medium">
          Etapa 1 de 5 • Siglo XVI
        </span>
        <button type="button" id="next-era" class="font-medium text-[#8E1323] hover:text-[#700E1B] disabled:opacity-35 disabled:pointer-events-none transition-colors cursor-pointer">
          Siguiente etapa →
        </button>
      </div>

    </div>
  </section>

  <!-- SCRIPTS: CONFIGURADOR SUPERIOR + TIMELINE HORIZONTAL -->
  <script>
    // --- 1. CONFIGURADOR SUPERIOR ---
    const pawConfig = {
      left: { tag: "Pata Izquierda", phrase: "la pata izquierda", goal: "atraer clientes y armonía", sentence: "Su gesto con la pata izquierda da la bienvenida a visitantes, clientes y vínculos positivos." },
      right: { tag: "Pata Derecha", phrase: "la pata derecha", goal: "atraer riqueza y prosperidad", sentence: "Su gesto con la pata derecha invoca la entrada de dinero, oportunidades y estabilidad material." },
      both: { tag: "Ambas Patas", phrase: "ambas patas", goal: "unir fortuna y protección", sentence: "Al alzar ambas patas a la vez, multiplica la llamada a la prosperidad mientras resguarda el espacio." }
    };

    const colorConfig = {
      tricolor: { file: "01_tri",    tag: "Tricolor Mi-ke", adj: "tricolor (Mi-ke)", accent: "text-amber-700",   sentence: "Combinado con el pelaje tricolor original de Japón, se convierte en el talismán más completo de suerte suprema y equilibrio." },
      white:    { file: "02_white",  tag: "Color Blanco",   adj: "blanco",           accent: "text-stone-600",   sentence: "Al ser blanco como los gatos del templo Gōtokuji, aporta pureza, calma y buena fortuna general al hogar." },
      black:    { file: "03_black",  tag: "Color Negro",    adj: "negro",            accent: "text-stone-800",   sentence: "El pelaje negro funciona como un poderoso escudo frente a las malas energías, envidias e infortunios." },
      gold:     { file: "04_golden", tag: "Color Dorado",   adj: "dorado",           accent: "text-[#C6922C]",   sentence: "Su acabado dorado potencia directamente el éxito comercial, los negocios y la abundancia financiera." },
      yellow:   { file: "05_yellow", tag: "Color Amarillo", adj: "amarillo",         accent: "text-yellow-600",  sentence: "En tono amarillo, favorece el ahorro, la estabilidad económica familiar y la alegría cotidiana." },
      green:    { file: "06_green",  tag: "Color Verde",    adj: "verde",            accent: "text-emerald-700", sentence: "El color verde suma concentración académica, sabiduría y protección en los viajes y la salud." },
      blue:     { file: "07_blue",   tag: "Color Azul",     adj: "azul",             accent: "text-sky-700",     sentence: "El pelaje azul añade serenidad mental, claridad para tomar decisiones y avance profesional." },
      purple:   { file: "08_purple", tag: "Color Morado",   adj: "morado",           accent: "text-purple-700",  sentence: "En color morado, simboliza longevidad, nobleza e inspiración creativa." },
      pink:     { file: "09_pink",   tag: "Color Rosa",     adj: "rosa",             accent: "text-rose-500",    sentence: "Su tonalidad rosa (sakura) favorece el amor, el romance y la cercanía afectiva." },
      red:      { file: "10_red",    tag: "Color Rojo",     adj: "rojo",             accent: "text-[#8E1323]",   sentence: "El rojo carmesí actúa como talismán de vitalidad, fortaleza física y protección de la salud." }
    };

    const anatomyConfig = {
      koban: { tag: "小判 • DETALLE", name: "Moneda Koban", text: "Moneda de oro del periodo Edo equivalente a diez millones de piezas («Senman Ryō»), símbolo de abundancia infinita." },
      collar: { tag: "首輪と鈴 • DETALLE", name: "Collar y Cascabel", text: "En el siglo XVII los gatos llevaban collar rojo de seda chirimen con cascabel para proteger el hogar y llamar a la fortuna." },
      cara: { tag: "表情 • DETALLE", name: "Expresión y Mirada", text: "Sus ojos arqueados en sonrisa encarnan el «Omotenashi»: la hospitalidad japonesa que recibe con calidez a cada invitado." }
    };

    const metaTags = document.getElementById('meta-tags');
    const headlineEl = document.getElementById('dynamic-headline');
    const meaningEl = document.getElementById('dynamic-meaning');

    const anatomyPanel = document.getElementById('anatomy-panel');
    const anatomyTag = document.getElementById('anatomy-tag');
    const anatomyName = document.getElementById('anatomy-name');
    const anatomyText = document.getElementById('anatomy-text');

    const schematicStage = document.getElementById('schematic-stage');
    const schematicLine = document.getElementById('schematic-line');
    const schematicHalo = document.getElementById('schematic-line-halo');
    const schematicEndDot = document.getElementById('schematic-end-dot');

    const catImage = document.getElementById('interactive-cat') as HTMLImageElement | null;
    const kobanSpot = document.getElementById('hotspot-koban');
    const pawBtns = document.querySelectorAll('[data-type="paw"]');
    const colorBtns = document.querySelectorAll('[data-type="color"]');
    const hotspots = document.querySelectorAll('.hotspot');
    const searchBtn = document.getElementById('btn-search-figure');

    let currentPaw = 'left';
    let currentColor = 'white';

    function updateCatAsset() {
      const p = pawConfig[currentPaw];
      const c = colorConfig[currentColor];
      if (!catImage || !p || !c) return;

      const posePrefix = currentPaw === 'both' ? '2' : '1';
      catImage.src = `/MN_${posePrefix}_${c.file}.svg`;
      catImage.alt = `Maneki-neko ${c.adj} con ${p.phrase}`;
      catImage.style.transform = currentPaw === 'right' ? 'scaleX(-1)' : 'scaleX(1)';

      if (kobanSpot) {
        kobanSpot.classList.remove('left-[45%]', 'left-[55%]', 'left-[50%]', 'top-[73%]', 'top-[75%]');
        if (currentPaw === 'right') {
          kobanSpot.classList.add('left-[55%]', 'top-[73%]');
        } else if (currentPaw === 'both') {
          kobanSpot.classList.add('left-[50%]', 'top-[75%]');
        } else {
          kobanSpot.classList.add('left-[45%]', 'top-[73%]');
        }
      }
    }

    function updateSchematicLine() {
      const activeSpot = document.querySelector('.hotspot.active-spot');
      if (!schematicStage || !activeSpot || !anatomyPanel || !schematicLine || !schematicHalo || !schematicEndDot) {
        schematicLine?.setAttribute('opacity', '0');
        schematicHalo?.setAttribute('opacity', '0');
        schematicEndDot?.setAttribute('opacity', '0');
        return;
      }

      const stageRect = schematicStage.getBoundingClientRect();
      const spotRect = activeSpot.getBoundingClientRect();
      const panelRect = anatomyPanel.getBoundingClientRect();

      if (stageRect.width === 0 || panelRect.left <= spotRect.right) {
        schematicLine.setAttribute('opacity', '0');
        schematicHalo.setAttribute('opacity', '0');
        schematicEndDot.setAttribute('opacity', '0');
        return;
      }

      const x1 = spotRect.left + spotRect.width / 2 - stageRect.left;
      const y1 = spotRect.top + spotRect.height / 2 - stageRect.top;
      const x2 = panelRect.left - stageRect.left;
      const y2 = panelRect.top + 14 - stageRect.top;
      const elbowX = x2 - 18;
      
      const pathData = `M ${x1.toFixed(1)} ${y1.toFixed(1)} L ${elbowX.toFixed(1)} ${y2.toFixed(1)} L ${x2.toFixed(1)} ${y2.toFixed(1)}`;

      schematicLine.setAttribute('d', pathData);
      schematicHalo.setAttribute('d', pathData);
      schematicEndDot.setAttribute('cx', x2.toFixed(1));
      schematicEndDot.setAttribute('cy', y2.toFixed(1));

      schematicLine.setAttribute('opacity', '1');
      schematicHalo.setAttribute('opacity', '0.85');
      schematicEndDot.setAttribute('opacity', '1');
    }

    function renderSentence() {
      const p = pawConfig[currentPaw];
      const c = colorConfig[currentColor];
      if (!p || !c || !headlineEl || !meaningEl || !metaTags) return;

      headlineEl.style.opacity = '0.2';
      meaningEl.style.opacity = '0.2';

      setTimeout(() => {
        metaTags.textContent = `${p.tag} • ${c.tag}`;
        headlineEl.innerHTML = `El Maneki-neko <span class="${c.accent} italic">${c.adj}</span> que alza <span class="underline decoration-[#8E1323]/40 decoration-2 underline-offset-4">${p.phrase}</span> para ${p.goal}`;
        meaningEl.textContent = `${p.sentence} ${c.sentence}`;

        headlineEl.style.opacity = '1';
        meaningEl.style.opacity = '1';
        
        if (searchBtn) {
          searchBtn.setAttribute('href', `/tienda/?color=${currentColor}&pata=${currentPaw}`);
        }
      }, 150);
    }

    pawBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        pawBtns.forEach(b => {
          b.classList.remove('bg-[#161412]', 'text-white', 'border-transparent');
          b.classList.add('bg-[#FAF6F0]', 'text-stone-600', 'border-stone-200');
        });
        btn.classList.remove('bg-[#FAF6F0]', 'text-stone-600', 'border-stone-200');
        btn.classList.add('bg-[#161412]', 'text-white', 'border-transparent');

        currentPaw = btn.getAttribute('data-key') || 'left';
        updateCatAsset();

        const start = performance.now();
        function animateLine(now) {
          updateSchematicLine();
          if (now - start < 520) requestAnimationFrame(animateLine);
        }
        requestAnimationFrame(animateLine);
        renderSentence();
      });
    });

    colorBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        colorBtns.forEach(b => {
          const r = b.getAttribute('data-ring');
          if (r) b.classList.remove(r);
          b.classList.remove('scale-110');
          b.classList.add('ring-transparent');
        });

        const activeRing = btn.getAttribute('data-ring');
        btn.classList.remove('ring-transparent');
        if (activeRing) btn.classList.add(activeRing);
        btn.classList.add('scale-110');

        currentColor = btn.getAttribute('data-key') || 'white';
        updateCatAsset();
        renderSentence();
      });
    });

    function selectAnatomy(spot) {
      const key = spot.getAttribute('data-info');
      const info = anatomyConfig[key];
      if (!info) return;

      hotspots.forEach(s => {
        s.classList.remove('ring-2', 'ring-[#8E1323]', 'scale-125', 'active-spot');
        s.classList.add('animate-pulse');
      });
      spot.classList.remove('animate-pulse');
      spot.classList.add('ring-2', 'ring-[#8E1323]', 'scale-125', 'active-spot');

      if (anatomyPanel && anatomyTag && anatomyName && anatomyText) {
        anatomyPanel.classList.remove('opacity-45', 'border-stone-300/80');
        anatomyPanel.classList.add('opacity-100', 'border-[#8E1323]');

        anatomyTag.classList.remove('text-stone-500');
        anatomyTag.classList.add('text-[#8E1323]');
        anatomyName.classList.remove('text-stone-600');
        anatomyName.classList.add('text-[#161412]');
        anatomyText.classList.remove('text-stone-500');
        anatomyText.classList.add('text-stone-700');

        anatomyTag.textContent = info.tag;
        anatomyName.textContent = info.name;
        anatomyText.textContent = info.text;
      }
      updateSchematicLine();
    }

    hotspots.forEach(spot => {
      spot.addEventListener('mouseenter', () => selectAnatomy(spot));
      spot.addEventListener('click', () => selectAnatomy(spot));
    });

    window.addEventListener('resize', updateSchematicLine);

    // --- 2. TIMELINE HORIZONTAL INTERACTIVA ---
    const eraNodes = document.querySelectorAll('.era-node');
    const eraPanels = document.querySelectorAll('.era-panel');
    const timelineProgress = document.getElementById('timeline-progress');
    const prevEraBtn = document.getElementById('prev-era') as HTMLButtonElement | null;
    const nextEraBtn = document.getElementById('next-era') as HTMLButtonElement | null;
    const eraStepIndicator = document.getElementById('era-step-indicator');

    const eraNames = ['Siglo XVI', 'Año 1615', 'Siglo XVIII', '1868 – 1912', 'Siglo XX – Hoy'];
    let activeEraIndex = 0;

    function activateEra(index: number) {
      if (index < 0 || index >= eraNodes.length) return;
      activeEraIndex = index;

      eraNodes.forEach((node, idx) => {
        const yearEl = node.querySelector('.era-year');
        const dotEl = node.querySelector('.era-dot');
        const labelEl = node.querySelector('.era-label');

        if (idx === index) {
          node.classList.add('active');
          yearEl?.classList.remove('text-stone-500');
          yearEl?.classList.add('text-[#8E1323]');
          dotEl?.classList.remove('bg-white', 'border-[3px]', 'border-[#C6922C]');
          dotEl?.classList.add('bg-[#8E1323]', 'border-4', 'border-[#FAF6F0]', 'ring-2', 'ring-[#8E1323]', 'scale-125');
          labelEl?.classList.remove('font-medium', 'text-stone-600');
          labelEl?.classList.add('font-semibold', 'text-[#161412]');
        } else if (idx < index) {
          node.classList.remove('active');
          yearEl?.classList.remove('text-[#8E1323]');
          yearEl?.classList.add('text-stone-500');
          dotEl?.classList.remove('bg-white', 'border-4', 'border-[#FAF6F0]', 'ring-2', 'ring-[#8E1323]', 'scale-125', 'border-[#C6922C]');
          dotEl?.classList.add('bg-[#8E1323]', 'border-[3px]', 'border-[#8E1323]');
          labelEl?.classList.remove('font-semibold', 'text-[#161412]');
          labelEl?.classList.add('font-medium', 'text-stone-600');
        } else {
          node.classList.remove('active');
          yearEl?.classList.remove('text-[#8E1323]');
          yearEl?.classList.add('text-stone-500');
          dotEl?.classList.remove('bg-[#8E1323]', 'border-4', 'border-[#FAF6F0]', 'ring-2', 'ring-[#8E1323]', 'scale-125', 'border-[#8E1323]');
          dotEl?.classList.add('bg-white', 'border-[3px]', 'border-[#C6922C]');
          labelEl?.classList.remove('font-semibold', 'text-[#161412]');
          labelEl?.classList.add('font-medium', 'text-stone-600');
        }
      });

      if (timelineProgress) {
        const pct = (index / (eraNodes.length - 1)) * 80;
        timelineProgress.style.width = `${pct}%`;
      }

      eraPanels.forEach((panel, idx) => {
        if (idx === index) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });

      if (prevEraBtn) prevEraBtn.disabled = index === 0;
      if (nextEraBtn) nextEraBtn.disabled = index === eraNodes.length - 1;
      if (eraStepIndicator) {
        eraStepIndicator.textContent = `Etapa ${index + 1} de ${eraNodes.length} • ${eraNames[index]}`;
      }
    }

    eraNodes.forEach((node, idx) => {
      node.addEventListener('click', () => activateEra(idx));
    });

    prevEraBtn?.addEventListener('click', () => activateEra(activeEraIndex - 1));
    nextEraBtn?.addEventListener('click', () => activateEra(activeEraIndex + 1));
  </script>
</BaseLayout>