---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { homeTranslations } from '../../i18n/home';

export async function getStaticPaths() {
  const historias = await getCollection('historia');
  return historias.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const tr = homeTranslations.es;
const { title, subtitle, era, period, location, coverImage, coverAlt, readingTime, featuredFigure } = entry.data;

const currentIndex = tr.eras.findIndex((e) => e.slug === entry.id);
const prevEra = currentIndex > 0 ? tr.eras[currentIndex - 1] : null;
const nextEra = currentIndex >= 0 && currentIndex < tr.eras.length - 1 ? tr.eras[currentIndex + 1] : null;
---

<BaseLayout title={`${title} | Manekineko.es`} description={subtitle}>
  <div class="max-w-6xl mx-auto px-6 py-10 sm:py-16">
    <nav class="mb-8">
      <a href="/#tradicion" class="text-sm font-medium text-[#8E1323] hover:underline">
        ← {tr.timelineTitle}
      </a>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
      <!-- Menú Lateral Cronológico -->
      <aside class="lg:col-span-4 lg:sticky lg:top-24 order-2 lg:order-1">
        <div class="bg-white border border-[#E5DEC9] rounded-2xl p-6 shadow-xs">
          <span class="hanko-stamp px-2 py-0.5 text-[10px] font-bold tracking-widest uppercase bg-[#FAF6F0]">
            {tr.timelineBadge}
          </span>
          <h2 class="font-serif text-lg font-bold text-[#161412] mt-2.5 mb-5">
            {tr.timelineTitle}
          </h2>

          <ol class="relative border-l-2 border-[#E5DEC9] ml-2.5 space-y-4">
            {tr.eras.map((item) => {
              const isCurrent = item.slug === entry.id;
              return (
                <li class="pl-5 relative group">
                  <span
                    class={`absolute top-2.5 rounded-full transition-all ${
                      isCurrent
                        ? '-left-[9px] w-4 h-4 bg-[#8E1323] border-2 border-white ring-4 ring-[#8E1323]/20'
                        : '-left-[7px] w-3 h-3 bg-white border-2 border-[#C6922C] group-hover:border-[#8E1323]'
                    }`}
                  />
                  <a
                    href={`/historia/${item.slug}/`}
                    aria-current={isCurrent ? 'page' : undefined}
                    class={`block rounded-xl transition-all ${
                      isCurrent
                        ? 'bg-[#FAF6F0] border border-[#E5DEC9] border-l-4 border-l-[#8E1323] p-3'
                        : 'p-2.5 -mt-1 hover:bg-[#FAF6F0]/70'
                    }`}
                  >
                    <div class={`text-[11px] font-bold uppercase tracking-wider ${isCurrent ? 'text-[#8E1323]' : 'text-stone-400 group-hover:text-[#8E1323]'}`}>
                      {item.year}
                    </div>
                    <div class={`font-serif text-sm leading-snug ${isCurrent ? 'font-bold text-[#161412]' : 'font-semibold text-stone-700 group-hover:text-[#161412]'}`}>
                      {item.nodeTitle}
                    </div>
                    <div class="text-xs text-stone-500 mt-0.5">{item.nodeSubtitle}</div>
                  </a>
                </li>
              );
            })}
          </ol>
        </div>
      </aside>

      <!-- Artículo Principal -->
      <article class="lg:col-span-8 order-1 lg:order-2 max-w-3xl">
        <header class="mb-10">
          <div class="flex flex-wrap items-center gap-3 text-xs font-medium text-[#8E1323] mb-4">
            <span class="px-3 py-1 rounded-full bg-white border border-[#E5DEC9]">
              {era}
            </span>
            <span class="text-stone-500">{period}</span>
            <span class="text-stone-500">• {location}</span>
            <span class="text-stone-500">• {readingTime}</span>
          </div>

          <h1 class="font-serif text-3xl sm:text-5xl font-bold text-[#161412] leading-tight mb-4">{title}</h1>
          <p class="text-lg sm:text-xl text-stone-600 leading-relaxed">{subtitle}</p>
        </header>

        <figure class="mb-12 rounded-2xl overflow-hidden border border-[#E5DEC9] bg-white shadow-xs">
          <img src={coverImage} alt={coverAlt} class="w-full aspect-[3/2] object-cover" />
        </figure>

        <div class="article-body text-[#161412] [&>p]:text-base sm:[&>p]:text-[17px] [&>p]:text-stone-700 [&>p]:leading-[1.85] [&>p]:mb-6 [&>h2]:font-serif [&>h2]:text-2xl sm:[&>h2]:text-3xl [&>h2]:font-bold [&>h2]:text-[#161412] [&>h2]:mt-14 [&>h2]:mb-5 [&>h2]:pt-8 [&>h2]:border-t [&>h2]:border-[#E5DEC9] [&>h2]:leading-snug [&>h2]:scroll-mt-28 [&>h3]:font-serif [&>h3]:text-xl sm:[&>h3]:text-2xl [&>h3]:font-bold [&>h3]:text-[#161412] [&>h3]:mt-9 [&>h3]:mb-3 [&>blockquote]:my-8 [&>blockquote]:border-l-4 [&>blockquote]:border-l-[#8E1323] [&>blockquote]:bg-white [&>blockquote]:py-4 [&>blockquote]:px-6 [&>blockquote]:rounded-r-2xl [&>blockquote]:shadow-xs [&>blockquote]:font-serif [&>blockquote]:italic [&>blockquote]:text-lg [&>blockquote]:text-[#161412] [&>blockquote>p]:mb-0 [&>ul]:my-6 [&>ul]:pl-6 [&>ul]:list-disc [&>ul]:space-y-3 [&>ul]:text-stone-700 [&>ul]:leading-relaxed [&>ol]:my-6 [&>ol]:pl-6 [&>ol]:list-decimal [&>ol]:space-y-3 [&>ol]:text-stone-700 [&>ol]:leading-relaxed [&>p:has(img)]:my-9 [&>p:has(img)]:bg-white [&>p:has(img)]:p-2.5 [&>p:has(img)]:rounded-2xl [&>p:has(img)]:border [&>p:has(img)]:border-[#E5DEC9] [&>p:has(img)]:shadow-xs [&_img]:w-full [&_img]:aspect-[3/2] [&_img]:object-cover [&_img]:rounded-xl [&_strong]:font-semibold [&_strong]:text-[#161412]">
          <Content />
        </div>

        <!-- Navegación Anterior / Siguiente Etapa -->
        <nav class="mt-12 pt-8 border-t border-[#E5DEC9] grid grid-cols-1 sm:grid-cols-2 gap-4">
          {prevEra ? (
            <a
              href={`/historia/${prevEra.slug}/`}
              class="p-4 rounded-2xl bg-white border border-[#E5DEC9] hover:border-[#8E1323]/40 transition-colors group"
            >
              <div class="text-xs font-semibold text-[#8E1323] mb-1">{tr.prevEra}</div>
              <div class="font-serif font-bold text-[#161412] group-hover:text-[#8E1323] transition-colors">
                {prevEra.nodeTitle}
              </div>
              <div class="text-xs text-stone-500">{prevEra.year}</div>
            </a>
          ) : <div />}

          {nextEra && (
            <a
              href={`/historia/${nextEra.slug}/`}
              class="p-4 rounded-2xl bg-white border border-[#E5DEC9] hover:border-[#8E1323]/40 transition-colors text-left sm:text-right group"
            >
              <div class="text-xs font-semibold text-[#8E1323] mb-1">{tr.nextEra}</div>
              <div class="font-serif font-bold text-[#161412] group-hover:text-[#8E1323] transition-colors">
                {nextEra.nodeTitle}
              </div>
              <div class="text-xs text-stone-500">{nextEra.year}</div>
            </a>
          )}
        </nav>

        <aside class="mt-10 p-6 sm:p-8 rounded-2xl bg-white border border-[#E5DEC9] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
          <div>
            <h2 class="font-serif text-xl font-bold text-[#161412] mb-1">{featuredFigure.name}</h2>
            <p class="text-sm text-stone-600 max-w-lg">{featuredFigure.meaning}</p>
          </div>

          <a
            href={featuredFigure.shopUrl}
            class="shrink-0 px-5 py-3 rounded-xl bg-[#8E1323] hover:bg-[#700E1B] text-white text-sm font-semibold transition-colors"
          >
            {tr.searchBtn}
          </a>
        </aside>
      </article>
    </div>
  </div>
</BaseLayout>
