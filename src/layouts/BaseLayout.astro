---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Universo cultural del Maneki-neko: configurador interactivo de patas y colores, historia japonesa, leyenda del templo Gōtokuji y figuras tradicionales.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
  </head>
  <body class="min-h-screen flex flex-col text-[#161412] antialiased selection:bg-[#8E1323] selection:text-white">
    <!-- Franja superior decorativa estilo Torii / Koban -->
    <div class="h-1.5 w-full bg-gradient-to-r from-[#161412] via-[#8E1323] to-[#C6922C]"></div>

    <header class="border-b border-[#E5DEC9] bg-[#FAF6F0]/95 sticky top-0 z-40 backdrop-blur-md">
      <div class="max-w-6xl mx-auto px-5 sm:px-8 py-3.5 flex flex-col md:flex-row items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2.5 group" aria-label="Manekineko.es - Inicio">
          <img
            src="/logo_img_gato.svg"
            alt="Manekineko"
            class="h-14 sm:h-16 w-auto shrink-0 object-contain transition-transform duration-300 group-hover:scale-105"
          />
          <img
            src="/logo_type.svg"
            alt="Manekineko.es"
            class="h-14 sm:h-16 w-auto shrink-0 object-contain mt-1"
          />
        </a>

        <nav class="flex flex-wrap items-center justify-center gap-6 sm:gap-8 text-sm font-medium tracking-wide text-stone-800">
          <a href="/" class="hover:text-[#8E1323] transition-colors">El Amuleto</a>
          <a href="/#tradicion" class="hover:text-[#8E1323] transition-colors">Tradición y Leyenda</a>
          <a
            href="/tienda/"
            class="px-4 py-2 rounded-full bg-[#8E1323] text-white hover:bg-[#700E1B] transition-colors shadow-xs"
          >
            Figuras
          </a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-[#161412] text-stone-300 mt-24 border-t-4 border-[#8E1323]">
      <div class="max-w-6xl mx-auto px-6 py-14 grid grid-cols-1 md:grid-cols-3 gap-10">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-[#8E1323] text-white font-serif text-sm">
              招福
            </span>
            <span class="font-serif text-lg tracking-wider text-white">MANEKINEKO.ES</span>
          </div>
          <p class="text-xs leading-relaxed text-stone-400">
            Archivo cultural, simbólico y artesanal dedicado al gato de la fortuna japonés desde sus orígenes hasta nuestros días.
          </p>
        </div>

        <div>
          <h3 class="text-xs uppercase tracking-widest text-[#E2B455] font-semibold mb-4">Explorar</h3>
          <ul class="space-y-2.5 text-sm">
            <li><a href="/" class="hover:text-white transition-colors">El Amuleto</a></li>
            <li><a href="/#tradicion" class="hover:text-white transition-colors">Tradición y Leyenda</a></li>
            <li><a href="/tienda/" class="hover:text-white transition-colors">Figuras</a></li>
          </ul>
        </div>

        <div class="flex flex-col justify-between">
          <div>
            <h3 class="text-xs uppercase tracking-widest text-[#E2B455] font-semibold mb-4">Tradición Nipona</h3>
            <p class="text-xs leading-relaxed text-stone-400">
              «Maneku» (招く) significa invitar a pasar; «Neko» (猫) significa gato. Un símbolo de hospitalidad, prosperidad y protección.
            </p>
          </div>
          <p class="text-[11px] text-stone-500 mt-6">
            © {new Date().getFullYear()} Manekineko.es — Algunos enlaces de la sección Figuras participan en programas de afiliación.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>