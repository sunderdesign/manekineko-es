---
import '../styles/global.css';
import {
  languages,
  defaultLang,
  ui,
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
  getSwitchLangUrl,
  type Lang,
} from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Universo cultural del Maneki-neko: configurador interactivo de patas y colores, historia japonesa, leyenda del templo Gōtokuji y figuras tradicionales.',
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const homeHref = translatePath('/');
const evolucionHref = translatePath('/#tradicion');
const leyendasHref = translatePath('/') + '#leyendas';
const figurasHref = translatePath('/tienda/');

const normalizedPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const normalizedHome = homeHref.replace(/\/$/, '') || '/';
const segments = normalizedPath.split('/').filter(Boolean);

const isHome = normalizedPath === normalizedHome;
const isHistoria = segments.includes('historia');
const isLeyendas = segments.includes('leyendas');
const isTienda = segments.includes('tienda');

// Migas de pan ("veletas") automáticas en los 9 idiomas
const homeCrumbLabel: Record<Lang, string> = {
  es: 'Inicio',
  en: 'Home',
  fr: 'Accueil',
  de: 'Start',
  it: 'Home',
  pt: 'Início',
  ja: 'ホーム',
  zh: '首页',
  ru: 'Главная',
};

const cleanPageTitle = title.split('|')[0].split('—')[0].trim();

type Crumb = { label: string; href?: string };
const breadcrumbs: Crumb[] = [{ label: homeCrumbLabel[lang], href: homeHref }];

if (!isHome) {
  const contentSegments = lang === defaultLang ? segments : segments.slice(1);
  const section = contentSegments[0];
  const hasDetail = contentSegments.length > 1;

  if (section === 'tienda') {
    if (hasDetail) {
      breadcrumbs.push({ label: t('nav.figuras'), href: figurasHref });
      breadcrumbs.push({ label: cleanPageTitle });
    } else {
      breadcrumbs.push({ label: t('nav.figuras') });
    }
  } else if (section === 'leyendas') {
    if (hasDetail) {
      breadcrumbs.push({ label: t('nav.leyendas'), href: leyendasHref });
      breadcrumbs.push({ label: cleanPageTitle });
    } else {
      breadcrumbs.push({ label: t('nav.leyendas') });
    }
  } else if (section === 'historia') {
    if (hasDetail) {
      breadcrumbs.push({ label: t('nav.evolucion'), href: evolucionHref });
      breadcrumbs.push({ label: cleanPageTitle });
    } else {
      breadcrumbs.push({ label: t('nav.evolucion') });
    }
  } else if (section === 'feng-shui') {
    breadcrumbs.push({ label: t('nav.fengshui') });
  } else if (section === 'cultura') {
    breadcrumbs.push({ label: cleanPageTitle });
  } else {
    breadcrumbs.push({ label: cleanPageTitle });
  }
}

const breadcrumbJsonLd = !isHome
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((c, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        name: c.label,
        ...(c.href ? { item: new URL(c.href, Astro.site).toString() } : {}),
      })),
    }
  : null;

const baseNavClass = 'px-3.5 py-2 rounded-full transition-colors';
const activeNavClass = `${baseNavClass} bg-[#8E1323] text-white hover:bg-[#700E1B] shadow-xs`;
const inactiveNavClass = `${baseNavClass} text-stone-800 hover:text-[#8E1323]`;

const mobileBaseNavClass = 'flex items-center justify-between px-4 py-3 rounded-xl text-base font-medium transition-colors';
const mobileActiveNavClass = `${mobileBaseNavClass} bg-[#8E1323] text-white shadow-xs`;
const mobileInactiveNavClass = `${mobileBaseNavClass} text-stone-800 hover:bg-white hover:text-[#8E1323]`;

const flagSvgs: Record<Lang, string> = {
  es: `<svg viewBox="0 0 24 18" class="w-full h-full block" aria-hidden="true"><rect width="24" height="18" fill="#AA151B"/><rect y="4.5" width="24" height="9" fill="#F1BF00"/><circle cx="7.5" cy="9" r="1.5" fill="#AA151B"/></svg>`,
  en: `<svg viewBox="0 0 24 18" class="w-full h-full block" aria-hidden="true"><rect width="24" height="18" fill="#012169"/><path d="M0,0 L24,18 M24,0 L0,18" stroke="#FFFFFF" stroke-width="3.2"/><path d="M0,0 L24,18 M24,0 L0,18" stroke="#C8102E" stroke-width="1.6"/><path d="M12,0 V18 M0,9 H24" stroke="#FFFFFF" stroke-width="5"/><path d="M12,0 V18 M0,9 H24" stroke="#C8102E" stroke-width="3"/></svg>`,
  fr: `<svg viewBox="0 0 24 18" class="w-full h-full block" aria-hidden="true"><rect width="8" height="18" fill="#002395"/><rect x="8" width="8" height="18" fill="#FFFFFF"/><rect x="16" width="8" height="18" fill="#ED2939"/></svg>`,
  de: `<svg viewBox="0 0 24 18" class="w-full h-full block" aria-hidden="true"><rect width="24" height="6" fill="#000000"/><rect y="6" width="24" height="6" fill="#DD0000"/><rect y="12" width="24" height="6" fill="#FFCE00"/></svg>`,
  it: `<svg viewBox="0 0 24 18" class="w-full h-full block" aria-hidden="true"><rect width="8" height="18" fill="#009246"/><rect x="8" width="8" height="18" fill="#FFFFFF"/><rect x="16" width="8" height="18" fill="#CE2B37"/></svg>`,
  pt: `<svg viewBox="0 0 24 18" class="w-full h-full block" aria-hidden="true"><rect width="9.5" height="18" fill="#006600"/><rect x="9.5" width="14.5" height="18" fill="#FF0000"/><circle cx="9.5" cy="9" r="3.2" fill="#FFCC00"/></svg>`,
  ja: `<svg viewBox="0 0 24 18" class="w-full h-full block" aria-hidden="true"><rect width="24" height="18" fill="#FFFFFF"/><circle cx="12" cy="9" r="4.5" fill="#BC002D"/></svg>`,
  zh: `<svg viewBox="0 0 24 18" class="w-full h-full block" aria-hidden="true"><rect width="24" height="18" fill="#DE2910"/><polygon points="5,2.5 5.8,4.8 8.2,4.8 6.2,6.2 7,8.5 5,7.1 3,8.5 3.8,6.2 1.8,4.8 4.2,4.8" fill="#FFDE00"/><circle cx="10.2" cy="3" r="0.8" fill="#FFDE00"/><circle cx="11.8" cy="4.8" r="0.8" fill="#FFDE00"/><circle cx="11.8" cy="7.2" r="0.8" fill="#FFDE00"/><circle cx="10.2" cy="9" r="0.8" fill="#FFDE00"/></svg>`,
  ru: `<svg viewBox="0 0 24 18" class="w-full h-full block" aria-hidden="true"><rect width="24" height="6" fill="#FFFFFF"/><rect y="6" width="24" height="6" fill="#0039A6"/><rect y="12" width="24" height="6" fill="#D52B1E"/></svg>`,
};

const langSwitchOptions = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  acronym: code.toUpperCase(),
  label: languages[code],
  flagSvg: flagSvgs[code],
  href: getSwitchLangUrl(Astro.url, code),
  bannerText: ui[code]['banner.text'],
  bannerCta: ui[code]['banner.cta'],
}));
---

<!doctype html>
<html lang={lang} class="scroll-smooth scroll-pt-24 md:scroll-pt-28">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {langSwitchOptions.map((opt) => (
      <link rel="alternate" hreflang={opt.code} href={new URL(opt.href, Astro.site)} />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(getSwitchLangUrl(Astro.url, defaultLang), Astro.site)}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    {breadcrumbJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    )}
  </head>
  <body class="min-h-screen flex flex-col text-[#161412] antialiased selection:bg-[#8E1323] selection:text-white">
    <!-- Aviso inteligente de idioma del navegador (oculto por defecto) -->
    <div
      id="lang-suggest-banner"
      class="hidden bg-[#161412] text-[#FAF6F0] text-xs py-2.5 px-4 border-b border-[#C6922C]/40"
    >
      <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-3">
        <p id="lang-suggest-text" class="text-stone-200"></p>
        <div class="flex items-center gap-3">
          <a
            id="lang-suggest-link"
            href="/"
            class="px-3 py-1 rounded-full bg-[#8E1323] hover:bg-[#700E1B] text-white font-semibold transition-colors"
          >
          </a>
          <button
            id="lang-suggest-close"
            type="button"
            aria-label="Cerrar aviso de idioma"
            class="text-stone-400 hover:text-white px-1.5 py-0.5 cursor-pointer"
          >
            ✕
          </button>
        </div>
      </div>
    </div>

    <!-- Franja superior decorativa estilo Torii / Koban -->
    <div class="h-1.5 w-full bg-gradient-to-r from-[#161412] via-[#8E1323] to-[#C6922C]"></div>

    <header class="border-b border-[#E5DEC9] bg-[#FAF6F0]/95 sticky top-0 z-40 backdrop-blur-md">
      <div class="max-w-6xl mx-auto px-4 sm:px-8 h-16 md:h-auto md:py-3.5 grid grid-cols-[1fr_auto_1fr] md:flex items-center justify-between gap-2 md:gap-4">
        
        <!-- Izquierda (Móvil): Botón Hamburguesa Moderno -->
        <div class="flex items-center justify-start md:hidden">
          <button
            id="mobile-menu-open"
            type="button"
            aria-label="Abrir menú de navegación"
            aria-controls="mobile-nav-drawer"
            aria-expanded="false"
            class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-white/90 border border-[#E5DEC9] text-[#161412] hover:border-[#8E1323] hover:text-[#8E1323] transition-colors shadow-2xs cursor-pointer"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h12M4 17h16" />
            </svg>
          </button>
        </div>

        <!-- Centro (Móvil) / Izquierda (Desktop): Logotipo -->
        <a href={homeHref} class="flex items-center justify-center md:justify-start gap-2 sm:gap-2.5 group" aria-label="Manekineko.es - Inicio">
          <img
            src="/logo_img_gato.svg"
            alt="Manekineko"
            class="h-10 sm:h-12 md:h-16 w-auto shrink-0 object-contain transition-transform duration-300 group-hover:scale-105"
          />
          <img
            src="/logo_type.svg"
            alt="Manekineko.es"
            class="h-9 sm:h-11 md:h-16 w-auto shrink-0 object-contain mt-0.5 md:mt-1"
          />
        </a>

        <!-- Derecha: Navegación Desktop + Selector de Idioma (opuesto a la hamburguesa en móvil) -->
        <div class="flex items-center justify-end gap-2 sm:gap-3">
          <nav
            id="main-nav"
            data-home-path={normalizedHome}
            class="hidden md:flex flex-wrap items-center justify-center gap-1.5 lg:gap-2 text-sm font-medium tracking-wide"
          >
            <a
              href={homeHref}
              data-nav="amuleto"
              class={isHome ? activeNavClass : inactiveNavClass}
            >
              {t('nav.amuleto')}
            </a>
            <a
              href={evolucionHref}
              data-nav="evolucion"
              class={isHistoria ? activeNavClass : inactiveNavClass}
            >
              {t('nav.evolucion')}
            </a>
            <a
              href={leyendasHref}
              data-nav="leyendas"
              class={isLeyendas ? activeNavClass : inactiveNavClass}
            >
              {t('nav.leyendas')}
            </a>
            <a
              href={figurasHref}
              data-nav="figuras"
              class={isTienda ? activeNavClass : inactiveNavClass}
            >
              {t('nav.figuras')}
            </a>
          </nav>

          <!-- Selector compacto: Bandera + Acrónimo (ES, EN, etc.) -->
          <div id="lang-dropdown-wrapper" class="relative">
            <button
              id="lang-dropdown-btn"
              type="button"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-label={`Idioma actual: ${lang.toUpperCase()}`}
              class="inline-flex items-center gap-1.5 bg-white/95 hover:bg-white border border-[#E5DEC9] hover:border-[#C6922C] rounded-full px-2.5 sm:px-3 py-1.5 text-xs font-bold tracking-wider text-stone-800 cursor-pointer transition-colors shadow-2xs"
            >
              <span
                class="w-4 h-3 rounded-[2px] overflow-hidden shrink-0 border border-black/15 inline-flex"
                set:html={flagSvgs[lang]}
              />
              <span>{lang.toUpperCase()}</span>
              <span class="text-[10px] text-stone-500 ml-0.5">▾</span>
            </button>

            <ul
              id="lang-dropdown-menu"
              role="listbox"
              class="hidden absolute right-0 mt-2 w-28 bg-white border border-[#E5DEC9] rounded-xl shadow-lg py-1 z-50"
            >
              {langSwitchOptions.map((opt) => {
                const isCurrent = opt.code === lang;
                return (
                  <li role="option" aria-selected={isCurrent}>
                    <a
                      href={opt.href}
                      data-lang-option
                      class={`flex items-center justify-between px-3 py-1.5 text-xs font-bold tracking-wider transition-colors ${
                        isCurrent
                          ? 'bg-[#FAF6F0] text-[#8E1323]'
                          : 'text-stone-700 hover:bg-[#FAF6F0] hover:text-[#8E1323]'
                      }`}
                    >
                      <span class="inline-flex items-center gap-2">
                        <span
                          class="w-4 h-3 rounded-[2px] overflow-hidden shrink-0 border border-black/15 inline-flex"
                          set:html={opt.flagSvg}
                        />
                        <span>{opt.acronym}</span>
                      </span>
                      {isCurrent && <span class="w-1.5 h-1.5 rounded-full bg-[#8E1323]" />}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        </div>
      </div>

      <!-- Barra de Migas de Pan / "Veletas" responsive en páginas interiores -->
      {!isHome && (
        <nav
          aria-label="Breadcrumb"
          class="border-t border-[#E5DEC9]/70 bg-white/75 backdrop-blur-xs"
        >
          <div class="max-w-6xl mx-auto px-4 sm:px-8 py-2 overflow-x-auto no-scrollbar">
            <ol class="flex items-center gap-1.5 text-[11px] sm:text-xs text-stone-500 whitespace-nowrap">
              {breadcrumbs.map((crumb, idx) => {
                const isLast = idx === breadcrumbs.length - 1;
                return (
                  <li class="inline-flex items-center gap-1.5">
                    {idx > 0 && (
                      <span class="text-[#C6922C] font-bold select-none" aria-hidden="true">
                        ›
                      </span>
                    )}
                    {crumb.href && !isLast ? (
                      <a
                        href={crumb.href}
                        class="hover:text-[#8E1323] font-medium transition-colors"
                      >
                        {crumb.label}
                      </a>
                    ) : (
                      <span
                        aria-current="page"
                        class="font-semibold text-[#161412] truncate max-w-[210px] sm:max-w-md"
                      >
                        {crumb.label}
                      </span>
                    )}
                  </li>
                );
              })}
            </ol>
          </div>
        </nav>
      )}
    </header>

    <!-- Panel Lateral Deslizante (Drawer) para Móvil -->
    <div
      id="mobile-nav-backdrop"
      class="fixed inset-0 bg-black/45 backdrop-blur-[2px] z-50 hidden opacity-0 transition-opacity duration-200 md:hidden"
      aria-hidden="true"
    ></div>

    <aside
      id="mobile-nav-drawer"
      aria-label="Menú principal móvil"
      class="fixed top-0 left-0 bottom-0 w-72 max-w-[82vw] bg-[#FAF6F0] border-r border-[#E5DEC9] shadow-2xl z-50 -translate-x-full transition-transform duration-300 ease-out flex flex-col justify-between md:hidden"
    >
      <div>
        <!-- Cabecera del panel móvil -->
        <div class="px-5 py-4 border-b border-[#E5DEC9] bg-white/80 flex items-center justify-between">
          <a href={homeHref} class="flex items-center gap-2">
            <img src="/logo_img_gato.svg" alt="Manekineko" class="h-9 w-auto object-contain" />
            <span class="font-serif text-base font-bold tracking-wider text-[#161412]">MANEKINEKO</span>
          </a>
          <button
            id="mobile-menu-close"
            type="button"
            aria-label="Cerrar menú"
            class="w-9 h-9 rounded-full border border-[#E5DEC9] bg-[#FAF6F0] text-stone-700 hover:text-[#8E1323] hover:border-[#8E1323] flex items-center justify-center cursor-pointer"
          >
            ✕
          </button>
        </div>

        <!-- Enlaces principales -->
        <nav class="p-4 space-y-1.5" aria-label="Secciones">
          <a
            href={homeHref}
            data-nav="amuleto"
            data-mobile-link
            class={isHome ? mobileActiveNavClass : mobileInactiveNavClass}
          >
            <span>{t('nav.amuleto')}</span>
            <span class="text-xs opacity-60">招福</span>
          </a>
          <a
            href={evolucionHref}
            data-nav="evolucion"
            data-mobile-link
            class={isHistoria ? mobileActiveNavClass : mobileInactiveNavClass}
          >
            <span>{t('nav.evolucion')}</span>
            <span class="text-xs opacity-60">歴史</span>
          </a>
          <a
            href={leyendasHref}
            data-nav="leyendas"
            data-mobile-link
            class={isLeyendas ? mobileActiveNavClass : mobileInactiveNavClass}
          >
            <span>{t('nav.leyendas')}</span>
            <span class="text-xs opacity-60">伝説</span>
          </a>
          <a
            href={figurasHref}
            data-nav="figuras"
            data-mobile-link
            class={isTienda ? mobileActiveNavClass : mobileInactiveNavClass}
          >
            <span>{t('nav.figuras')}</span>
            <span class="text-xs opacity-60">図鑑</span>
          </a>
        </nav>
      </div>

      <!-- Pie del panel móvil con selector rápido de los 9 idiomas -->
      <div class="p-4 border-t border-[#E5DEC9] bg-white/70 space-y-3">
        <div class="text-[10px] font-bold uppercase tracking-widest text-stone-500">
          {languages[lang]} ({lang.toUpperCase()})
        </div>
        <div class="grid grid-cols-3 gap-1.5">
          {langSwitchOptions.map((opt) => {
            const isCurrent = opt.code === lang;
            return (
              <a
                href={opt.href}
                data-lang-option
                class={`flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-lg border text-[11px] font-bold ${
                  isCurrent
                    ? 'bg-[#8E1323] text-white border-[#8E1323]'
                    : 'bg-white text-stone-700 border-[#E5DEC9] hover:border-[#8E1323]'
                }`}
              >
                <span
                  class="w-3.5 h-2.5 rounded-[1px] overflow-hidden shrink-0 border border-black/15 inline-flex"
                  set:html={opt.flagSvg}
                />
                <span>{opt.acronym}</span>
              </a>
            );
          })}
        </div>
      </div>
    </aside>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-[#161412] text-stone-300 mt-24 border-t-4 border-[#8E1323]">
      <div class="max-w-6xl mx-auto px-6 py-14 grid grid-cols-1 md:grid-cols-3 gap-10">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-[#8E1323] text-white font-serif text-sm">
              招福
            </span>
            <span class="font-serif text-lg tracking-wider text-white">MANEKINEKO.ES</span>
          </div>
          <p class="text-xs leading-relaxed text-stone-400">
            {t('footer.desc')}
          </p>
        </div>

        <div>
          <h3 class="text-xs uppercase tracking-widest text-[#E2B455] font-semibold mb-4">{t('footer.explore')}</h3>
          <ul class="space-y-2.5 text-sm">
            <li><a href={homeHref} class="hover:text-white transition-colors">{t('nav.amuleto')}</a></li>
            <li><a href={evolucionHref} class="hover:text-white transition-colors">{t('nav.evolucion')}</a></li>
            <li><a href={leyendasHref} class="hover:text-white transition-colors">{t('nav.leyendas')}</a></li>
            <li><a href={figurasHref} class="hover:text-white transition-colors">{t('nav.figuras')}</a></li>
            <li><a href={translatePath('/feng-shui/')} class="hover:text-white transition-colors">{t('nav.fengshui')}</a></li>
          </ul>
        </div>

        <div class="flex flex-col justify-between">
          <div>
            <h3 class="text-xs uppercase tracking-widest text-[#E2B455] font-semibold mb-4">{t('footer.traditionTitle')}</h3>
            <p class="text-xs leading-relaxed text-stone-400">
              {t('footer.traditionText')}
            </p>
          </div>
          <p class="text-[11px] text-stone-500 mt-6">
            © {new Date().getFullYear()} Manekineko.es — {t('footer.affiliate')}
          </p>
        </div>
      </div>
    </footer>

    <script
      id="i18n-runtime-data"
      type="application/json"
      set:html={JSON.stringify({ currentLang: lang, options: langSwitchOptions })}
    />

    <script>
      // 0. Menú lateral deslizante (Drawer móvil)
      const mobileOpenBtn = document.getElementById('mobile-menu-open');
      const mobileCloseBtn = document.getElementById('mobile-menu-close');
      const mobileDrawer = document.getElementById('mobile-nav-drawer');
      const mobileBackdrop = document.getElementById('mobile-nav-backdrop');

      function openMobileDrawer() {
        if (!mobileDrawer || !mobileBackdrop) return;
        mobileBackdrop.classList.remove('hidden');
        requestAnimationFrame(() => {
          mobileBackdrop.classList.remove('opacity-0');
          mobileDrawer.classList.remove('-translate-x-full');
        });
        mobileOpenBtn?.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }

      function closeMobileDrawer() {
        if (!mobileDrawer || !mobileBackdrop) return;
        mobileBackdrop.classList.add('opacity-0');
        mobileDrawer.classList.add('-translate-x-full');
        mobileOpenBtn?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        setTimeout(() => {
          mobileBackdrop.classList.add('hidden');
        }, 250);
      }

      mobileOpenBtn?.addEventListener('click', openMobileDrawer);
      mobileCloseBtn?.addEventListener('click', closeMobileDrawer);
      mobileBackdrop?.addEventListener('click', closeMobileDrawer);
      document.querySelectorAll('[data-mobile-link]').forEach((el) => {
        el.addEventListener('click', closeMobileDrawer);
      });

      // 1. Desplegable compacto de idioma (Bandera + Acrónimo)
      const langWrapper = document.getElementById('lang-dropdown-wrapper');
      const langBtn = document.getElementById('lang-dropdown-btn');
      const langMenu = document.getElementById('lang-dropdown-menu');

      langBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !langMenu?.classList.contains('hidden');
        if (isOpen) {
          langMenu?.classList.add('hidden');
          langBtn.setAttribute('aria-expanded', 'false');
        } else {
          langMenu?.classList.remove('hidden');
          langBtn.setAttribute('aria-expanded', 'true');
        }
      });

      document.querySelectorAll('[data-lang-option]').forEach((link) => {
        link.addEventListener('click', () => {
          localStorage.setItem('manekineko_lang_dismissed', '1');
        });
      });

      document.addEventListener('click', (e) => {
        if (langWrapper && !langWrapper.contains(e.target as Node)) {
          langMenu?.classList.add('hidden');
          langBtn?.setAttribute('aria-expanded', 'false');
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          langMenu?.classList.add('hidden');
          langBtn?.setAttribute('aria-expanded', 'false');
          closeMobileDrawer();
        }
      });

      // 2. Detección inteligente del idioma del navegador
      const runtimeEl = document.getElementById('i18n-runtime-data');
      if (runtimeEl?.textContent) {
        try {
          const { currentLang, options } = JSON.parse(runtimeEl.textContent) as {
            currentLang: string;
            options: Array<{ code: string; href: string; bannerText: string; bannerCta: string }>;
          };

          const dismissed = localStorage.getItem('manekineko_lang_dismissed');
          if (!dismissed) {
            const rawBrowserLang = (navigator.languages?.[0] || navigator.language || '').toLowerCase();
            const shortBrowserLang = rawBrowserLang.split('-')[0];
            const match = options.find((o) => o.code === shortBrowserLang && o.code !== currentLang);

            if (match) {
              const banner = document.getElementById('lang-suggest-banner');
              const bannerText = document.getElementById('lang-suggest-text');
              const bannerLink = document.getElementById('lang-suggest-link') as HTMLAnchorElement | null;
              const bannerClose = document.getElementById('lang-suggest-close');

              if (banner && bannerText && bannerLink) {
                bannerText.textContent = match.bannerText;
                bannerLink.textContent = match.bannerCta;
                bannerLink.href = match.href;
                banner.classList.remove('hidden');

                bannerLink.addEventListener('click', () => {
                  localStorage.setItem('manekineko_lang_dismissed', '1');
                });

                bannerClose?.addEventListener('click', () => {
                  localStorage.setItem('manekineko_lang_dismissed', '1');
                  banner.classList.add('hidden');
                });
              }
            }
          }
        } catch {
          // Ignorar errores de parseo
        }
      }

      // 3. Resaltado dinámico entre "El Amuleto", "Evolución" y "Leyendas" en la portada
      const tradicionSection = document.getElementById('tradicion');
      const leyendasSection = document.getElementById('leyendas');

      if (tradicionSection || leyendasSection) {
        const activeClasses = ['bg-[#8E1323]', 'text-white', 'hover:bg-[#700E1B]', 'shadow-xs'];
        const inactiveClasses = ['text-stone-800', 'hover:text-[#8E1323]'];
        let lockUntil = 0;

        const setHomeActiveNav = (target: string) => { const pairs: [string, string[], string[]][] = [['#main-nav [data-nav]', activeClasses, inactiveClasses], ['#mobile-nav-drawer [data-nav]', ['bg-[#8E1323]', 'text-white', 'shadow-xs'], ['text-stone-800', 'hover:bg-white', 'hover:text-[#8E1323]']]]; for (const [sel, on, off] of pairs) { document.querySelectorAll(sel).forEach((link) => { const nav = link.getAttribute('data-nav'); if (nav !== 'amuleto' && nav !== 'evolucion' && nav !== 'leyendas') return; link.classList.remove(...(nav === target ? off : on)); link.classList.add(...(nav === target ? on : off)); }); } }; const lockTarget = (target: 'amuleto' | 'evolucion' | 'leyendas') => {
          lockUntil = Date.now() + 950;
          setHomeActiveNav(target);
        };

        const syncScrollNav = () => {
          if (Date.now() < lockUntil) return;

          const atBottom =
            window.innerHeight + Math.ceil(window.scrollY) >=
            document.documentElement.scrollHeight - 120;

          if (leyendasSection) {
            const lRect = leyendasSection.getBoundingClientRect();
            if (
              lRect.top <= window.innerHeight * 0.45 ||
              (atBottom && lRect.top < window.innerHeight * 0.85)
            ) {
              setHomeActiveNav('leyendas');
              return;
            }
          }

          if (tradicionSection && tradicionSection.getBoundingClientRect().top <= 220) {
            setHomeActiveNav('evolucion');
          } else {
            setHomeActiveNav('amuleto');
          }
        };

        const syncFromHash = () => {
          if (window.location.hash === '#leyendas') {
            lockTarget('leyendas');
          } else if (window.location.hash === '#tradicion') {
            lockTarget('evolucion');
          } else {
            syncScrollNav();
          }
        };

        document.querySelectorAll('[data-nav="leyendas"]').forEach((el) => {
          el.addEventListener('click', () => lockTarget('leyendas'));
        });
        document.querySelectorAll('[data-nav="evolucion"]').forEach((el) => {
          el.addEventListener('click', () => lockTarget('evolucion'));
        });
        document.querySelectorAll('[data-nav="amuleto"]').forEach((el) => {
          el.addEventListener('click', () => lockTarget('amuleto'));
        });

        syncFromHash();
        window.addEventListener('hashchange', syncFromHash);
        window.addEventListener('scroll', syncScrollNav, { passive: true });
      }
    </script>
  </body>
</html>