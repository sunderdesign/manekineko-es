---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Portal cultural sobre la historia, significado y tradición del Maneki-neko en Japón.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
  </head>
  <body class="min-h-screen flex flex-col antialiased selection:bg-red-800 selection:text-white">
    <header class="border-b border-stone-200/80 bg-[#FAF8F5]/95 sticky top-0 z-10 backdrop-blur-sm">
      <div class="max-w-5xl mx-auto px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-3 group" aria-label="Manekineko.es - Inicio">
          <img
            src="/logo_img_gato.svg"
            alt="Manekineko"
            class="h-12 sm:h-14 w-auto shrink-0 object-contain transition-transform duration-300 group-hover:scale-105"
          />
          <img
            src="/logo_type.svg"
            alt="Manekineko.es"
            class="h-8 sm:h-10 w-auto shrink-0 object-contain mt-1"
          />
        </a>

        <nav class="flex items-center gap-8 text-sm tracking-wide text-stone-700">
          <a href="/" class="hover:text-[#B91C1C] transition-colors">Inicio</a>
          <a href="/cultura/" class="hover:text-[#B91C1C] transition-colors">Revista Cultural</a>
          <a href="/tienda/" class="hover:text-[#B91C1C] transition-colors">Selección</a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-stone-200 mt-20 py-12 text-xs text-stone-500">
      <div class="max-w-5xl mx-auto px-6 flex flex-col sm:flex-row justify-between items-center gap-4">
        <p>© {new Date().getFullYear()} Manekineko.es — Archivo cultural del amuleto japonés.</p>
        <p class="text-center sm:text-right max-w-md">
          Algunos enlaces de la sección Selección participan en programas de afiliación sin coste adicional para el lector.
        </p>
      </div>
    </footer>
  </body>
</html>