---
import FengShuiHomeBanner from './FengShuiHomeBanner.astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslatedPath, useTranslations, type Lang } from '../i18n/ui';
import { homeTranslations, type ColorKey, type PawKey } from '../i18n/home';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = homeTranslations[lang];
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const allLeyendas = await getCollection('leyendas');
const baseLeyendas = allLeyendas
  .filter((e) => !e.id.includes('/'))
  .sort((a, b) => a.data.order - b.data.order);
const leyendas = baseLeyendas.map((base) => {
  const entry = lang === 'es' ? base : (allLeyendas.find((e) => e.id === `${lang}/${base.id}`) ?? base);
  return { slug: base.id, data: entry.data };
});

const introCopy: Record<string, { tag: string; headlineHtml: string; meaningText: string; lockedHint: string }> = {
  es: {
    tag: 'EN REPOSO • SIN PATA ALZADA',
    headlineHtml:
      'Todavía es solo un gato descansando: <span class="underline decoration-[#8E1323]/40 decoration-2 underline-offset-4">alza una pata</span> para hacerlo Maneki-neko.',
    meaningText:
      'Un Maneki-neko con las patas bajadas aún no llama a la fortuna. Elige primero qué pata quieres levantar y desbloquearás los colores para darle su propósito.',
    lockedHint: 'Elige primero qué pata levantar',
  },
  en: {
    tag: 'AT REST • NO PAW RAISED',
    headlineHtml:
      'Right now it’s just a cat taking a break: <span class="underline decoration-[#8E1323]/40 decoration-2 underline-offset-4">raise a paw</span> to make it a Maneki-neko.',
    meaningText:
      'A Maneki-neko with both paws down isn’t calling fortune yet. Choose which paw to raise first to unlock the colors and define its purpose.',
    lockedHint: 'Choose which paw to raise first',
  },
  fr: {
    tag: 'AU REPOS • AUCUNE PATTE LEVÉE',
    headlineHtml:
      'Ce n’est encore qu’un chat qui se repose : <span class="underline decoration-[#8E1323]/40 decoration-2 underline-offset-4">levez une patte</span> pour en faire un Maneki-neko.',
    meaningText:
      'Un Maneki-neko les pattes baissées n’appelle pas encore la chance. Choisissez d’abord quelle patte lever pour débloquer les couleurs.',
    lockedHint: 'Choisissez d’abord quelle patte lever',
  },
};

const intro = introCopy[lang] ?? introCopy.es;
const shopBaseUrl = translatePath('/tienda/');

const colorButtons: Array<{ key: ColorKey; ring: string; bgClass: string }> = [
  { key: 'tricolor', ring: 'ring-amber-700', bgClass: 'bg-gradient-to-tr from-stone-900 via-amber-500 to-white border-stone-400' },
  { key: 'white', ring: 'ring-stone-800', bgClass: 'bg-white border-stone-400' },
  { key: 'gold', ring: 'ring-amber-600', bgClass: 'bg-gradient-to-tr from-[#B7811E] to-[#FFF1B8] border-amber-500' },
  { key: 'yellow', ring: 'ring-yellow-500', bgClass: 'bg-yellow-300 border-yellow-500' },
  { key: 'green', ring: 'ring-emerald-600', bgClass: 'bg-emerald-600 border-emerald-800' },
  { key: 'blue', ring: 'ring-sky-600', bgClass: 'bg-sky-600 border-sky-800' },
  { key: 'purple', ring: 'ring-purple-700', bgClass: 'bg-purple-700 border-purple-900' },
  { key: 'pink', ring: 'ring-rose-400', bgClass: 'bg-rose-300 border-rose-400' },
  { key: 'red', ring: 'ring-[#8E1323]', bgClass: 'bg-[#8E1323] border-red-950' },
  { key: 'black', ring: 'ring-stone-800', bgClass: 'bg-[#18181B] border-black' },
];
---

<BaseLayout title={tr.seoTitle} description={tr.seoDescription}>
  <!-- 1. EXPLORADOR INTERACTIVO -->
  <section class="bg-seigaiha border-b border-[#E5DEC9] relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-6 py-5 sm:py-7 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
        <!-- Columna Izquierda -->
        <div class="lg:col-span-5 text-center lg:text-left flex flex-col justify-center">
          <div class="inline-flex flex-wrap items-center gap-2.5 mb-3 justify-center lg:justify-start">
            <span class="hanko-stamp px-2 py-0.5 text-[10px] font-bold tracking-widest uppercase bg-white/85">
              招き猫 • {t('nav.amuleto')}
            </span>
            <span id="meta-tags" class="text-[11px] uppercase tracking-[0.16em] text-[#8E1323] font-semibold">
              {intro.tag}
            </span>
          </div>

          <h1
            id="dynamic-headline"
            class="font-serif text-2xl sm:text-3xl lg:text-[1.9rem] leading-[1.2] text-[#161412] mb-3 transition-opacity duration-200"
            set:html={intro.headlineHtml}
          />

          <p id="dynamic-meaning" class="text-sm text-stone-700 leading-relaxed max-w-xl mx-auto lg:mx-0 transition-opacity duration-200">
            {intro.meaningText}
          </p>
        </div>

        <!-- Columna Derecha -->
        <div class="lg:col-span-7 flex flex-col items-center">
          <div id="schematic-stage" class="relative w-full flex flex-col sm:flex-row items-center justify-center lg:justify-end gap-5 sm:gap-7">
            <svg id="schematic-svg" class="hidden sm:block absolute inset-0 w-full h-full pointer-events-none z-30" aria-hidden="true">
              <path id="schematic-line-halo" d="" fill="none" stroke="#FAF6F0" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" opacity="0" />
              <path id="schematic-line" d="" fill="none" stroke="#8E1323" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" opacity="0" />
              <circle id="schematic-end-dot" cx="0" cy="0" r="2.5" fill="#8E1323" opacity="0" />
            </svg>

            <div class="relative w-64 h-64 sm:w-72 sm:h-72 shrink-0 flex items-center justify-center rounded-full overflow-hidden bg-white border-2 border-[#C6922C]/45 shadow-xl">
              <div class="absolute inset-3 rounded-full border border-dashed border-[#161412]/15 pointer-events-none z-20"></div>
              
              <img
                id="interactive-cat"
                src="/MN_00_line_0.svg"
                alt="Maneki-neko"
                class="w-44 sm:w-48 h-auto object-contain relative z-10 transition-transform duration-500 ease-in-out"
              />

              <button
                id="hotspot-koban"
                data-info="koban"
                class="hotspot absolute z-20 left-[56%] top-[75%] -translate-x-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-[#8E1323] border-2 border-white shadow-md ring-4 ring-[#8E1323]/20 animate-pulse hover:animate-none hover:scale-125 transition-all duration-300 cursor-pointer"
                aria-label={tr.anatomy.koban.name}
                title={tr.anatomy.koban.name}
              ></button>

              <button
                data-info="collar"
                class="hotspot absolute z-20 left-[58%] top-[51%] -translate-x-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-[#8E1323] border-2 border-white shadow-md ring-4 ring-[#8E1323]/20 animate-pulse hover:animate-none hover:scale-125 transition-all duration-300 cursor-pointer"
                aria-label={tr.anatomy.collar.name}
                title={tr.anatomy.collar.name}
              ></button>

              <button
                data-info="cara"
                class="hotspot absolute z-20 left-[62%] top-[36%] -translate-x-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-[#8E1323] border-2 border-white shadow-md ring-4 ring-[#8E1323]/20 animate-pulse hover:animate-none hover:scale-125 transition-all duration-300 cursor-pointer"
                aria-label={tr.anatomy.cara.name}
                title={tr.anatomy.cara.name}
              ></button>
            </div>

            <div
              id="anatomy-panel"
              style="opacity: 1;"
              class="w-full sm:w-56 shrink-0 bg-white border border-[#E5DEC9] border-l-4 border-l-[#8E1323] rounded-xl px-4 py-3.5 shadow-md text-center sm:text-left relative z-20 transition-all duration-300"
            >
              <div id="anatomy-tag" class="text-[11px] font-bold uppercase tracking-[0.15em] text-[#8E1323] mb-1">
                {tr.anatomyDefaultTag}
              </div>

              <h2 id="anatomy-name" class="font-serif text-lg font-bold text-[#161412] leading-tight mb-1">
                {tr.anatomyDefaultName}
              </h2>

              <p id="anatomy-text" class="text-xs font-medium text-[#161412] leading-relaxed">
                {tr.anatomyDefaultText}
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Barra Inferior -->
      <div class="mt-5 w-full bg-white/90 backdrop-blur-sm border border-[#E5DEC9] rounded-2xl p-2.5 shadow-sm flex flex-col lg:flex-row items-center justify-between gap-3">
        <div class="flex flex-col md:flex-row items-center justify-center lg:justify-start gap-4 flex-1">
          <div class="flex flex-wrap items-center justify-center gap-2 pl-2">
            <span class="text-[11px] font-bold uppercase tracking-widest text-stone-400 mr-1">{tr.pawLabel}</span>
            <button data-type="paw" data-key="left" class="control-btn px-3 py-1.5 rounded-lg bg-[#FAF6F0] text-stone-600 border border-stone-200 text-xs font-medium hover:bg-stone-200 transition-colors cursor-pointer">{tr.paws.left.btn}</button>
            <button data-type="paw" data-key="right" class="control-btn px-3 py-1.5 rounded-lg bg-[#FAF6F0] text-stone-600 border border-stone-200 text-xs font-medium hover:bg-stone-200 transition-colors cursor-pointer">{tr.paws.right.btn}</button>
            <button data-type="paw" data-key="both" class="control-btn px-3 py-1.5 rounded-lg bg-[#FAF6F0] text-stone-600 border border-stone-200 text-xs font-medium hover:bg-stone-200 transition-colors cursor-pointer">{tr.paws.both.btn}</button>
          </div>

          <div class="hidden md:block h-6 w-px bg-stone-200"></div>

          <div class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-3">
            <span class="text-[11px] font-bold uppercase tracking-widest text-stone-400 mr-1">{tr.colorLabel}</span>
            {colorButtons.map((btn) => (
              <button
                type="button"
                disabled
                data-type="color"
                data-key={btn.key}
                data-ring={btn.ring}
                data-label={tr.colors[btn.key].label}
                class={`control-color w-6 h-6 rounded-full border shadow-sm transition-all ring-2 ring-offset-2 ring-transparent opacity-35 cursor-not-allowed ${btn.bgClass}`}
                aria-label={tr.colors[btn.key].label}
                title={intro.lockedHint}
              ></button>
            ))}
          </div>
        </div>

        <a 
          href={shopBaseUrl}
          id="btn-search-figure"
          class="shrink-0 w-full lg:w-auto flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#8E1323] to-[#700E1B] text-white font-medium text-sm tracking-wide shadow-md hover:shadow-lg transition-all group"
        >
          <span>{tr.searchBtn}</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 2. TIMELINE -->
  <FengShuiHomeBanner lang={lang} />

  <section id="tradicion" class="max-w-6xl mx-auto px-6 py-16 sm:py-20">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2.5 mb-2.5">
        <span class="hanko-stamp px-2 py-0.5 text-[10px] font-bold tracking-widest uppercase bg-white/90">
          {tr.timelineBadge}
        </span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl text-[#161412] mb-3">
        {tr.timelineTitle}
      </h2>
      <p class="text-stone-600 text-sm sm:text-base">
        {tr.timelineSubtitle}
      </p>
    </div>

    <div class="relative mb-10 overflow-x-auto pb-4">
      <div class="min-w-[640px] relative px-6 pt-2">
        <div class="absolute top-[42px] left-12 right-12 h-[2px] bg-[#E5DEC9]"></div>
        <div id="timeline-progress" class="absolute top-[42px] left-12 h-[2px] bg-[#8E1323] transition-all duration-500" style="width: 0%;"></div>

        <div class="relative z-10 grid grid-cols-5 gap-2">
          {tr.eras.map((era, idx) => (
            <button
              type="button"
              data-era={idx}
              class={`era-node ${idx === 0 ? 'active' : ''} flex flex-col items-center text-center group cursor-pointer focus:outline-none`}
            >
              <span class={`era-year text-xs font-bold tracking-wider uppercase mb-2 transition-colors ${idx === 0 ? 'text-[#8E1323]' : 'text-stone-500 group-hover:text-[#8E1323]'}`}>
                {era.year}
              </span>
              <span class={`era-dot w-5 h-5 rounded-full transition-all duration-300 shadow-xs ${idx === 0 ? 'bg-[#8E1323] border-4 border-[#FAF6F0] ring-2 ring-[#8E1323] scale-125' : 'bg-white border-[3px] border-[#C6922C] group-hover:border-[#8E1323]'}`}></span>
              <span class={`era-label font-serif text-sm mt-3 leading-tight ${idx === 0 ? 'font-semibold text-[#161412]' : 'font-medium text-stone-600 group-hover:text-[#161412]'}`}>
                {era.nodeTitle}
              </span>
              <span class="text-[11px] text-stone-400 mt-0.5">{era.nodeSubtitle}</span>
            </button>
          ))}
        </div>
      </div>
    </div>

    <div class="bg-white border border-[#E5DEC9] rounded-2xl shadow-sm overflow-hidden">
      {tr.eras.map((era, idx) => (
        <article id={`era-panel-${idx}`} class={`era-panel ${idx === 0 ? '' : 'hidden'} p-6 sm:p-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center`}>
          <div class="lg:col-span-7 space-y-4">
            <div class="flex flex-wrap items-center gap-3">
              <span class="hanko-stamp px-2.5 py-0.5 text-xs font-bold">{era.stamp}</span>
              <span class="text-xs font-semibold uppercase tracking-widest text-[#C6922C]">{era.eraMeta}</span>
            </div>
            
            <h3 class="font-serif text-2xl sm:text-3xl text-[#161412]">
              {era.title}
            </h3>
            
            <p class="text-sm sm:text-base text-stone-700 leading-relaxed">
              {era.p1}
            </p>
            
            <p class="text-sm sm:text-base text-stone-700 leading-relaxed">
              {era.p2}
            </p>

            <div class="bg-[#FAF6F0] border-l-2 border-[#C6922C] p-4 rounded-r-lg mb-6">
              <p class="text-xs text-stone-600 leading-relaxed">
                <strong class="text-[#161412]">{era.noteLabel}</strong> {era.noteText}
              </p>
            </div>

            <div class="pt-2 border-t border-[#E5DEC9]">
              <a
                href={translatePath(`/historia/${era.slug}/`)}
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#8E1323] hover:text-[#700E1B] transition-colors group"
              >
                <span>{tr.timelineReadMore}</span>
                <span aria-hidden="true" class="group-hover:translate-x-1 transition-transform">→</span>
              </a>
            </div>
          </div>

          <div class="lg:col-span-5">
            <figure class="aspect-[3/2] rounded-xl bg-[#FAF6F0] border border-[#E5DEC9] overflow-hidden shadow-xs">
              <img
                src={era.image}
                alt={era.imageAlt}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </figure>
          </div>
        </article>
      ))}

      <div class="bg-[#FAF6F0] border-t border-[#E5DEC9] px-6 py-3 flex items-center justify-between text-xs">
        <button type="button" id="prev-era" class="font-medium text-stone-500 hover:text-[#8E1323] disabled:opacity-35 disabled:pointer-events-none transition-colors cursor-pointer" disabled>
          {tr.prevEra}
        </button>
        <span id="era-step-indicator" class="text-stone-500 font-medium">
          {tr.stepTemplate.replace('{current}', '1').replace('{total}', String(tr.eras.length)).replace('{year}', tr.eras[0].year)}
        </span>
        <button type="button" id="next-era" class="font-medium text-[#8E1323] hover:text-[#700E1B] disabled:opacity-35 disabled:pointer-events-none transition-colors cursor-pointer">
          {tr.nextEra}
        </button>
      </div>
    </div>
  </section>

  <!-- 3. SECCIÓN DE LEYENDAS -->
  {leyendas.length > 0 && (
    <section id="leyendas" class="border-t border-[#E5DEC9] bg-white/70 py-16 sm:py-20">
      <div class="max-w-6xl mx-auto px-6">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
          <div>
            <div class="inline-flex items-center gap-2.5 mb-2.5">
              <span class="hanko-stamp px-2 py-0.5 text-[10px] font-bold tracking-widest uppercase bg-white">
                {tr.legendsBadge}
              </span>
            </div>
            <h2 class="font-serif text-3xl sm:text-4xl text-[#161412]">
              {tr.legendsTitle}
            </h2>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {leyendas.map((leyenda) => (
            <article class="group bg-[#FAF6F0] border border-[#E5DEC9] rounded-2xl overflow-hidden shadow-xs hover:shadow-md transition-all duration-300 flex flex-col">
              <a href={translatePath(`/leyendas/${leyenda.slug}/`)} class="block aspect-[3/2] overflow-hidden bg-white relative">
                <img
                  src={leyenda.data.coverImage}
                  alt={leyenda.data.coverAlt}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <span class="absolute top-3 left-3 px-2.5 py-1 text-[11px] font-semibold rounded-full bg-white/95 text-[#8E1323] border border-[#E5DEC9]">
                  {leyenda.data.isOriginal ? tr.legendsOriginalBadge : leyenda.data.era}
                </span>
              </a>

              <div class="p-6 flex-1 flex flex-col">
                <div class="text-xs text-stone-500 mb-2 flex items-center justify-between">
                  <span>{leyenda.data.location}</span>
                  <span>{leyenda.data.readingTime}</span>
                </div>

                <h3 class="font-serif text-xl font-bold text-[#161412] group-hover:text-[#8E1323] transition-colors mb-2.5">
                  <a href={translatePath(`/leyendas/${leyenda.slug}/`)}>
                    {leyenda.data.title}
                  </a>
                </h3>

                <p class="text-sm text-stone-600 leading-relaxed mb-5 flex-1">
                  {leyenda.data.summary}
                </p>

                <div class="pt-3.5 border-t border-[#E5DEC9]">
                  <a
                    href={translatePath(`/leyendas/${leyenda.slug}/`)}
                    class="text-sm font-semibold text-[#8E1323] hover:text-[#700E1B] inline-flex items-center gap-1"
                  >
                    {tr.legendsReadMore}
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <script
    id="home-i18n-data"
    type="application/json"
    set:html={JSON.stringify({
      headlineTemplate: tr.headlineTemplate,
      paws: tr.paws,
      colors: tr.colors,
      anatomy: tr.anatomy,
      eraYears: tr.eras.map((e) => e.year),
      stepTemplate: tr.stepTemplate,
      shopBaseUrl,
    })}
  />

  <script>
    import type { AnatomyKey, ColorKey, PawKey } from '../i18n/home';

    const dataEl = document.getElementById('home-i18n-data');
    if (dataEl?.textContent) {
      const cfg = JSON.parse(dataEl.textContent) as {
        headlineTemplate: string;
        paws: Record<PawKey, { tag: string; phrase: string; goal: string; sentence: string }>;
        colors: Record<ColorKey, { file: string; tag: string; adj: string; accent: string; sentence: string }>;
        anatomy: Record<AnatomyKey, { tag: string; name: string; text: string }>;
        eraYears: string[];
        stepTemplate: string;
        shopBaseUrl: string;
      };

      const metaTags = document.getElementById('meta-tags');
      const headlineEl = document.getElementById('dynamic-headline');
      const meaningEl = document.getElementById('dynamic-meaning');

      const anatomyPanel = document.getElementById('anatomy-panel');
      const anatomyTag = document.getElementById('anatomy-tag');
      const anatomyName = document.getElementById('anatomy-name');
      const anatomyText = document.getElementById('anatomy-text');

      const schematicStage = document.getElementById('schematic-stage');
      const schematicLine = document.getElementById('schematic-line');
      const schematicHalo = document.getElementById('schematic-line-halo');
      const schematicEndDot = document.getElementById('schematic-end-dot');

      const catImage = document.getElementById('interactive-cat') as HTMLImageElement | null;
      const kobanSpot = document.getElementById('hotspot-koban');
      const pawBtns = document.querySelectorAll('[data-type="paw"]');
      const colorBtns = document.querySelectorAll('[data-type="color"]');
      const hotspots = document.querySelectorAll('.hotspot');
      const searchBtn = document.getElementById('btn-search-figure');

      let current