---
import { useTranslatedPath, type Lang } from '../i18n/ui';
import { fengShuiHomeBanner } from '../i18n/fengshui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const b = fengShuiHomeBanner[lang];
const translatePath = useTranslatedPath(lang);
const heroImgSrc = '/images/guia-ubicacion-zoom.jpg';
---

<section aria-label={b.badge} class="max-w-6xl mx-auto px-5 sm:px-8 pt-6 pb-2">
  <div class="relative overflow-hidden rounded-2xl border border-[#E5DEC9] bg-white shadow-xs">
    <div class="h-1 w-full bg-gradient-to-r from-[#8E1323] via-[#C6922C] to-[#161412]"></div>
    <div class="p-5 sm:p-7 flex flex-col md:flex-row items-center justify-between gap-5">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-5">
        <div class="w-full sm:w-40 h-36 sm:h-28 rounded-xl overflow-hidden border border-[#E5DEC9] shrink-0 bg-[#FAF6F0]">
          <img
            src={heroImgSrc}
            alt={b.title}
            loading="lazy"
            class="w-full h-full object-cover object-[48%_48%] scale-[1.65] transition-transform duration-300"
          />
        </div>
        <div class="space-y-1.5">
          <span class="inline-block px-2.5 py-0.5 text-[10px] font-bold tracking-widest uppercase rounded-full bg-[#FAF6F0] border border-[#E5DEC9] text-[#8E1323]">
            {b.badge}
          </span>
          <h2 class="font-serif text-lg sm:text-xl font-bold text-[#161412] leading-snug">
            {b.title}
          </h2>
          <p class="text-xs sm:text-sm text-stone-600 leading-relaxed max-w-2xl">
            {b.desc}
          </p>
        </div>
      </div>
      <a
        href={translatePath('/feng-shui/')}
        class="w-full md:w-auto shrink-0 inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-[#161412] hover:bg-[#8E1323] text-white text-xs sm:text-sm font-semibold transition-colors"
      >
        <span>{b.cta}</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>