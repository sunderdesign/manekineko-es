---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const leyendas = await getCollection('leyendas');
  return leyendas.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, subtitle, era, location, coverImage, coverAlt, readingTime, isOriginal, featuredFigure } = entry.data;
---

<BaseLayout title={`${title} | Leyendas de Maneki-neko`} description={subtitle}>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
    <nav class="mb-8">
      <a href="/leyendas/" class="text-sm font-medium text-[#8B1E1E] hover:underline">
        &larr; Volver a todas las leyendas
      </a>
    </nav>

    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-3 text-xs font-medium text-[#7A1C1C] mb-4">
        <span class="px-3 py-1 rounded-full bg-[#F3E8D8] border border-[#E2D1B8]">
          {isOriginal ? 'Relato Original · Manekineko.es' : era}
        </span>
        <span class="text-[#6E5A4B]">{location}</span>
        <span class="text-[#6E5A4B]">&bull; {readingTime}</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-[#2C1810] leading-tight mb-4">
        {title}
      </h1>

      <p class="text-lg sm:text-xl text-[#5C4A3E] leading-relaxed">
        {subtitle}
      </p>
    </header>

    <figure class="mb-12 rounded-2xl overflow-hidden border border-[#E6DCCB] bg-[#F3ECE0] shadow-sm">
      <img
        src={coverImage}
        alt={coverAlt}
        class="w-full aspect-[3/2] object-cover"
      />
    </figure>

    <div class="prose prose-lg max-w-none text-[#2C1810] prose-headings:font-serif prose-headings:text-[#2C1810] prose-blockquote:border-l-[#8B1E1E] prose-blockquote:bg-[#FAF6F0] prose-blockquote:py-2 prose-blockquote:px-5 prose-blockquote:rounded-r-lg prose-strong:text-[#7A1C1C]">
      <Content />
    </div>

    <aside class="mt-14 p-6 sm:p-8 rounded-2xl bg-[#FAF6F0] border border-[#E2D1B8] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div>
        <p class="text-xs uppercase tracking-widest text-[#8B1E1E] font-semibold mb-1">
          El talismán de esta historia
        </p>
        <h2 class="font-serif text-xl font-bold text-[#2C1810] mb-1">
          {featuredFigure.name}
        </h2>
        <p class="text-sm text-[#5C4A3E] max-w-lg">
          {featuredFigure.meaning}
        </p>
      </div>

      <a
        href={featuredFigure.shopUrl}
        class="shrink-0 px-5 py-3 rounded-xl bg-[#8B1E1E] hover:bg-[#6E1515] text-white text-sm font-semibold transition-colors"
      >
        Ver en el catálogo
      </a>
    </aside>
  </article>
</BaseLayout>